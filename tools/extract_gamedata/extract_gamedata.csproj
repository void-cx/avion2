<Project Sdk="Microsoft.NET.Sdk">

  <!-- Developer tool: builds assets/gamedata from an installed AION2 client. Not part of Avion2.sln; the app never
       references it. See README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>extract_gamedata</AssemblyName>
    <RootNamespace>ExtractGameData</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mounts the .pak/.utoc containers (GAME_Aion2) and reads a .usmap for "usmap". Apache-2.0. -->
    <PackageReference Include="CUE4Parse" Version="1.2.2.202611" />
    <!-- The .dat layer: BLAKE3 for the key derivation, LZ4 blocks. -->
    <PackageReference Include="Blake3" Version="3.0.2" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <!-- CUE4Parse pulls in 9.0.0, which has a known vulnerability (GHSA-73j8-2gch-69rq) -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="9.0.22" />
  </ItemGroup>

  <ItemGroup>
    <None Include="schema.json" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
