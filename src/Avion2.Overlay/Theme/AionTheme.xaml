<!--
    AION2 design language for AVION2 (inspired by the official site and the in-game armory):
    night-navy backdrops, aether-cyan glow, violet secondary, silver serif display type,
    pill buttons with diamond end caps, thin glowing card borders with a star ornament.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette -->
    <Color x:Key="AionNight">#070D18</Color>
    <Color x:Key="AionDeep">#0B1727</Color>
    <Color x:Key="AionPanel">#101E31</Color>
    <Color x:Key="AionAether">#7FD8FF</Color>
    <Color x:Key="AionAetherDeep">#2F7FE0</Color>
    <Color x:Key="AionViolet">#9B86FF</Color>
    <Color x:Key="AionGold">#D9C08A</Color>
    <Color x:Key="AionSilver">#E9F1F8</Color>

    <SolidColorBrush x:Key="AionNightBrush" Color="{StaticResource AionNight}" />
    <SolidColorBrush x:Key="AionAetherBrush" Color="{StaticResource AionAether}" />
    <SolidColorBrush x:Key="AionVioletBrush" Color="{StaticResource AionViolet}" />
    <SolidColorBrush x:Key="AionGoldBrush" Color="{StaticResource AionGold}" />
    <SolidColorBrush x:Key="AionSilverBrush" Color="{StaticResource AionSilver}" />
    <SolidColorBrush x:Key="AionMutedBrush" Color="#8FA3B8" />
    <SolidColorBrush x:Key="AionLinkBrush" Color="#4D9BFF" />
    <!-- Item grades, as on the armory page -->
    <SolidColorBrush x:Key="GradeLegendBrush" Color="#FF9A3C" />
    <SolidColorBrush x:Key="GradeRareBrush" Color="#4D9BFF" />
    <SolidColorBrush x:Key="GradeCommonBrush" Color="#6BD36B" />

    <!-- Display type: silver serif capitals with an aether glow -->
    <FontFamily x:Key="AionDisplayFont">pack://application:,,,/AVION2;component/Fonts/#Cinzel, Palatino Linotype, Georgia, Serif</FontFamily>
    <DropShadowEffect x:Key="AionGlow" Color="#7FD8FF" BlurRadius="18" ShadowDepth="0" Opacity="0.75" />
    <DropShadowEffect x:Key="AionSoftGlow" Color="#7FD8FF" BlurRadius="10" ShadowDepth="0" Opacity="0.45" />

    <DropShadowEffect x:Key="AionPillGlow" Color="#7FD8FF" BlurRadius="16" ShadowDepth="0" Opacity="0.55" />
    <DropShadowEffect x:Key="AionPillGlowHover" Color="#9ADFFF" BlurRadius="26" ShadowDepth="0" Opacity="0.95" />

    <Style x:Key="AionHeroTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AionDisplayFont}" />
        <Setter Property="FontSize" Value="52" />
        <Setter Property="Foreground" Value="{StaticResource AionSilverBrush}" />
        <Setter Property="Effect" Value="{StaticResource AionGlow}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AionHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AionDisplayFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource AionSilverBrush}" />
        <Setter Property="Effect" Value="{StaticResource AionSoftGlow}" />
    </Style>

    <!-- Card border: thin light top edge fading into a dark frame -->
    <LinearGradientBrush x:Key="AionCardBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C8E6FF" Offset="0" />
        <GradientStop Color="#4A6E91" Offset="0.25" />
        <GradientStop Color="#1C324A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AionCardBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D9142A44" Offset="0" />
        <GradientStop Color="#E60A1626" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="AionCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AionCardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource AionCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="18,14" />
    </Style>

    <!-- Armory panel (inner pages): charcoal with a hairline border -->
    <Style x:Key="ArmoryPanel" TargetType="Border">
        <Setter Property="Background" Value="#E6161A21" />
        <Setter Property="BorderBrush" Value="#2E3642" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <!-- Four-pointed star ornament (card tops, dividers) -->
    <Geometry x:Key="AionStarGeometry">M 10,0 L 12,8 L 20,10 L 12,12 L 10,20 L 8,12 L 0,10 L 8,8 Z</Geometry>
    <Style x:Key="AionStar" TargetType="Path">
        <Setter Property="Data" Value="{StaticResource AionStarGeometry}" />
        <Setter Property="Fill" Value="#EAF7FF" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Effect" Value="{StaticResource AionGlow}" />
    </Style>

    <!-- Divider: hairline fading out at both ends -->
    <LinearGradientBrush x:Key="AionDividerBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#007FD8FF" Offset="0" />
        <GradientStop Color="#AA9FDFFF" Offset="0.5" />
        <GradientStop Color="#007FD8FF" Offset="1" />
    </LinearGradientBrush>

    <!-- Pill button with diamond end caps (official "Play Now" style) -->
    <ControlTemplate x:Key="AionPillTemplate" TargetType="Button">
        <Grid x:Name="Root" MinHeight="44" Cursor="Hand" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Pill" Grid.ColumnSpan="3" Margin="8,0" CornerRadius="22"
                    Background="{TemplateBinding Background}" BorderBrush="#E6F6FF" BorderThickness="1.4"
                    Effect="{StaticResource AionPillGlow}" />
            <!-- Top highlight -->
            <Border Grid.ColumnSpan="3" Margin="20,3,20,0" Height="14" VerticalAlignment="Top" CornerRadius="10" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#88FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Path Grid.Column="0" Width="14" Height="14" Margin="0,0,-2,0" Stretch="Uniform" Fill="#F4FBFF"
                  Data="M 0,5 L 5,0 L 10,5 L 5,10 Z" VerticalAlignment="Center" />
            <ContentPresenter Grid.Column="1" Margin="26,8" HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="White" TextElement.FontFamily="{StaticResource AionDisplayFont}"
                              TextElement.FontSize="17" />
            <Path Grid.Column="2" Width="14" Height="14" Margin="-2,0,0,0" Stretch="Uniform" Fill="#F4FBFF"
                  Data="M 0,5 L 5,0 L 10,5 L 5,10 Z" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Pill" Property="BorderBrush" Value="White" />
                <Setter TargetName="Pill" Property="Effect" Value="{StaticResource AionPillGlowHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="AionPrimaryButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource AionPillTemplate}" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#9ADFFF" Offset="0" />
                    <GradientStop Color="#3E8CF0" Offset="0.35" />
                    <GradientStop Color="#2F6FE0" Offset="0.65" />
                    <GradientStop Color="#9ADFFF" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AionSecondaryButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource AionPillTemplate}" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#D2C4FF" Offset="0" />
                    <GradientStop Color="#8F6CFF" Offset="0.35" />
                    <GradientStop Color="#6A4CFF" Offset="0.65" />
                    <GradientStop Color="#D2C4FF" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small label chip ("Notice" / "Event" on the site) -->
    <Style x:Key="AionChip" TargetType="Border">
        <Setter Property="Background" Value="#CC0A111C" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Top navigation link (site header) -->
    <Style x:Key="AionNavLink" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#D6E2EE" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,26,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <ContentPresenter x:Name="Text" Margin="0,8" VerticalAlignment="Center" />
                        <Border x:Name="Line" Height="2" VerticalAlignment="Bottom" Background="{StaticResource AionAetherBrush}"
                                Opacity="0" CornerRadius="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#7FD8FF" BlurRadius="8" ShadowDepth="0" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Line" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
