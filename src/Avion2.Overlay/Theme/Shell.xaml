<!--
    The app shell (icon rail, sidebars, list rows, detail panes, flat buttons). Shared by every theme: colours come
    from the theme's keys as DynamicResource (see Theme/README.md, "Shell"), so a theme switch restyles it too.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Avion2.Overlay">

    <!-- Stroke icons on a 24 × 24 grid -->
    <Geometry x:Key="IconHome">M3,11 L12,4 L21,11 V20 H15 V14 H9 V20 H3 Z</Geometry>
    <Geometry x:Key="IconTimers">M12,7 V12 L15,14 M12,3 A9,9 0 1 0 12.01,3 Z</Geometry>
    <Geometry x:Key="IconMap">M9,4 L3,6 V20 L9,18 L15,20 L21,18 V4 L15,6 Z M9,4 V18 M15,6 V20</Geometry>
    <Geometry x:Key="IconForge">M5,20 L13,12 M13,4 L20,11 L17,14 L10,7 Z M4,21 H11</Geometry>
    <Geometry x:Key="IconHistory">M4,6 H20 M4,12 H20 M4,18 H14</Geometry>
    <Geometry x:Key="IconSettings">M4,7 H13 M17,7 H20 M15,5 V9 M4,17 H7 M11,17 H20 M9,15 V19</Geometry>
    <Geometry x:Key="IconSearch">M11,4 A7,7 0 1 0 11.01,4 Z M20,20 L16,16</Geometry>
    <Geometry x:Key="IconList">M4,6 H20 M4,12 H20 M4,18 H20</Geometry>
    <Geometry x:Key="IconStar">M12,3 L14.6,8.6 L20.6,9.3 L16.1,13.4 L17.3,19.4 L12,16.4 L6.7,19.4 L7.9,13.4 L3.4,9.3 L9.4,8.6 Z</Geometry>
    <Geometry x:Key="IconPlay">M8,5 V19 L19,12 Z</Geometry>
    <Geometry x:Key="IconFolder">M3,7 V19 H21 V9 H11 L9,7 Z</Geometry>
    <Geometry x:Key="IconTrash">M4,7 H20 M9,7 V4 H15 V7 M6,7 L7,20 H17 L18,7</Geometry>
    <Geometry x:Key="IconCopy">M8,8 H20 V20 H8 Z M4,16 V4 H16</Geometry>
    <Geometry x:Key="IconShield">M12,3 L19,7 V13 C19,17 16,20 12,21 C8,20 5,17 5,13 V7 Z</Geometry>
    <Geometry x:Key="IconCrown">M4,18 L6,8 L10,12 L12,5 L14,12 L18,8 L20,18 Z</Geometry>
    <Geometry x:Key="IconRift">M12,3 A9,9 0 1 0 12.01,3 Z M12,8 A4,4 0 1 0 12.01,8 Z</Geometry>
    <Geometry x:Key="IconCalendar">M4,6 H20 V20 H4 Z M4,10 H20 M8,3 V7 M16,3 V7</Geometry>
    <Geometry x:Key="IconPin">M15,3 L21,9 L17,10 L13,14 L14,19 L12,21 L3,12 L5,10 L10,11 L14,7 Z M7.5,16.5 L3,21</Geometry>
    <Geometry x:Key="IconBell">M6,16 V11 A6,6 0 0 1 18,11 V16 L20,18 H4 Z M10,21 H14</Geometry>
    <Geometry x:Key="IconFit">M4,9 V4 H9 M20,9 V4 H15 M4,15 V20 H9 M20,15 V20 H15</Geometry>

    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="1.8" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
    </Style>

    <!-- Type -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontWeight" Value="{DynamicResource DisplayWeight}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource TitleBrush}" />
    </Style>
    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <Style x:Key="BrandTitle" TargetType="TextBlock">
        <Setter Property="Text" Value="AVION2" />
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontWeight" Value="{DynamicResource BrandWeight}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="{DynamicResource TitleBrush}" />
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SectionLabelBrush}" />
    </Style>
    <Style x:Key="PaneTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TitleBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="StatLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TitleBrush}" />
    </Style>

    <!-- Surfaces -->
    <Style x:Key="SurfaceCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource ShellRadius}" />
        <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style x:Key="FloatingPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource FloatingPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FloatingBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource ShellRadius}" />
    </Style>
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PillBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource PillTextBrush}" />
        <Setter Property="TextElement.FontSize" Value="12" />
    </Style>
    <Style x:Key="AccentPill" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{DynamicResource AccentPillBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>

    <!-- Thin progress line (share of the damage, countdowns) -->
    <Style x:Key="ThinBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="PART_Track">
                        <Border Background="{TemplateBinding Background}" CornerRadius="1.5" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="1.5" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon rail -->
    <Style x:Key="RailButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="Height" Value="64" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Fill" Background="{DynamicResource RailActiveBrush}" Opacity="0" />
                        <Border x:Name="Bar" Width="2" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" Opacity="0" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Viewbox Width="20" Height="20">
                                <Path Style="{StaticResource IconPath}" Stroke="{TemplateBinding Foreground}"
                                      Data="{Binding (local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
                            </Viewbox>
                            <ContentPresenter HorizontalAlignment="Center" Margin="0,5,0,0" TextElement.FontSize="11" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fill" Property="Opacity" Value="1" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar entries: a view (radio) or an action (button), icon + text + optional count -->
    <ControlTemplate x:Key="SideEntryTemplate" TargetType="RadioButton">
        <Border x:Name="Bg" Background="Transparent" CornerRadius="{DynamicResource ShellRadius}" Padding="14,0">
            <DockPanel>
                <Viewbox DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,12,0">
                    <Path Style="{StaticResource IconPath}" Stroke="{TemplateBinding Foreground}"
                          Data="{Binding (local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
                </Viewbox>
                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                           Text="{Binding (local:Ui.Count), RelativeSource={RelativeSource TemplatedParent}}" />
                <ContentPresenter VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RowHoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SideSelectedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TitleBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="SideActionTemplate" TargetType="Button">
        <Border x:Name="Bg" Background="Transparent" CornerRadius="{DynamicResource ShellRadius}" Padding="14,0">
            <DockPanel>
                <Viewbox DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,12,0">
                    <Path Style="{StaticResource IconPath}" Stroke="{TemplateBinding Foreground}"
                          Data="{Binding (local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
                </Viewbox>
                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                           Text="{Binding (local:Ui.Count), RelativeSource={RelativeSource TemplatedParent}}" />
                <ContentPresenter VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RowHoverBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="SideItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource SideEntryTemplate}" />
    </Style>
    <Style x:Key="SideAction" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource SideActionTemplate}" />
    </Style>

    <!-- Underlined tab links -->
    <Style x:Key="TabLink" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,26,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <ContentPresenter Margin="2,0,2,10" VerticalAlignment="Bottom" />
                        <Border x:Name="Line" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource AccentBrush}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Line" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small segmented toggles (period filter, playback speed) -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="3" Padding="10,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SideSelectedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flat buttons: one accent action per pane, quiet ones beside it -->
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ShellRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource ShellRadius}" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox x:Name="Icon" Width="15" Height="15" Margin="0,0,8,0">
                                <Path Style="{StaticResource IconPath}" Stroke="{TemplateBinding Foreground}"
                                      Data="{Binding (local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
                            </Viewbox>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="local:Ui.Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="QuietToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" Background="Transparent" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource ShellRadius}">
                        <Viewbox Width="16" Height="16">
                            <Path Style="{StaticResource IconPath}" Stroke="{TemplateBinding Foreground}"
                                  Data="{Binding (local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentPillBrush}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Round play / pause button -->
    <Style x:Key="PlayToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Ellipse x:Name="Bg" Fill="{DynamicResource AccentBrush}" />
                        <Path x:Name="Play" Data="M15,12 L33,22 L15,32 Z" Fill="{DynamicResource OnAccentBrush}" Width="44" Height="44" />
                        <Path x:Name="Pause" Data="M15,13 H20 V31 H15 Z M24,13 H29 V31 H24 Z" Fill="{DynamicResource OnAccentBrush}" Width="44" Height="44" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Fill" Value="{DynamicResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Play" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Pause" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Search box with an icon and a placeholder (local:Ui.Placeholder) -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bg" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource ShellRadius}" Padding="10,0">
                        <DockPanel>
                            <Viewbox DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,8,0">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSearch}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2.2" />
                            </Viewbox>
                            <Grid VerticalAlignment="Center">
                                <TextBlock x:Name="Hint" Text="{TemplateBinding local:Ui.Placeholder}" Foreground="{DynamicResource SectionLabelBrush}"
                                           IsHitTestVisible="False" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center" />
                            </Grid>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lists: rows with a selection tint and an accent edge -->
    <Style x:Key="PlainList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>
    <Style x:Key="ListRow" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="3" />
                        <Border x:Name="Edge" Width="2" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                            <Setter TargetName="Edge" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Group header in lists ("Today · 12 fights") -->
    <DataTemplate x:Key="ListGroupHeader">
        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Margin="8,10,8,4" Padding="0,0,0,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" FontSize="12">
                    <Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=" fights" />
                </TextBlock>
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
            </DockPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
