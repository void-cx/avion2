<Window x:Class="Avion2.Overlay.CompassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Avion2.Overlay"
        Title="AVION2 Compass"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" FontFamily="{DynamicResource BodyFont}" FontSize="12">
    <Window.Resources>
        <!-- Compact pill button -->
        <Style x:Key="CompassButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TitleBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="10" Padding="14,10,14,14" Background="{DynamicResource NoticeBackground}" BorderBrush="{DynamicResource NoticeBorderBrush}"
            BorderThickness="1" MouseLeftButtonDown="Card_MouseLeftButtonDown" Cursor="SizeAll" Width="236">
        <StackPanel>
            <Grid>
                <TextBlock x:Name="Kind" Text="Hidden cube" Foreground="{DynamicResource ChipTextBrush}" FontSize="11" VerticalAlignment="Center" />
                <Button Style="{StaticResource HeaderButton}" Content="&#xE711;" HorizontalAlignment="Right" Margin="0,0,-6,0" Click="Close_Click" ToolTip="Close" />
            </Grid>

            <local:CompassDial x:Name="Dial" Width="180" Height="180" Margin="0,4,0,6" HorizontalAlignment="Center" />

            <TextBlock x:Name="Turn" Foreground="{DynamicResource TitleBrush}" FontFamily="{DynamicResource DisplayFont}" FontSize="15"
                       HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock x:Name="Detail" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" Margin="0,3,0,0" />

            <Button Style="{StaticResource CompassButton}" Margin="0,12,0,0" Click="Skip_Click"
                    ToolTip="Hide this one for a while (time set on the Map tab) and lead to the next">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Skip" VerticalAlignment="Center" />
                    <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="6,1,0,0" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
