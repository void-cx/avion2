<Window x:Class="Avion2.Overlay.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Avion2.Overlay"
        Title="AVION2"
        ThemeMode="Dark"
        Width="1280" Height="800" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ContentBrush}"
        FontFamily="{DynamicResource BodyFont}" FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="76" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Icon rail -->
        <Border Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel x:Name="Rail">
                <Image DockPanel.Dock="Top" Source="{DynamicResource RailLogo}" Width="40" Height="40" Margin="0,18,0,18"
                       RenderOptions.BitmapScalingMode="HighQuality" ToolTip="AVION2" />
                <RadioButton DockPanel.Dock="Bottom" Style="{StaticResource RailButton}" Content="Settings" Tag="settings" GroupName="Nav"
                             local:Ui.Icon="{StaticResource IconSettings}" Checked="Nav_Checked" Margin="0,0,0,8" />
                <Ellipse x:Name="NavDot" DockPanel.Dock="Bottom" Width="8" Height="8" Margin="0,0,0,10" Fill="{DynamicResource IdleBrush}"
                         ToolTip="{Binding Text, Source={x:Static local:ShellStatus.Current}}" />
                <StackPanel>
                    <RadioButton Style="{StaticResource RailButton}" Content="Home" Tag="home" GroupName="Nav"
                                 local:Ui.Icon="{StaticResource IconHome}" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource RailButton}" Content="Timers" Tag="timers" GroupName="Nav"
                                 local:Ui.Icon="{StaticResource IconTimers}" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource RailButton}" Content="Map" Tag="map" GroupName="Nav"
                                 local:Ui.Icon="{StaticResource IconMap}" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource RailButton}" Content="Forge" Tag="forge" GroupName="Nav"
                                 local:Ui.Icon="{StaticResource IconForge}" Checked="Nav_Checked" ToolTip="Gear Forge" />
                    <RadioButton Style="{StaticResource RailButton}" Content="History" Tag="history" GroupName="Nav"
                                 local:Ui.Icon="{StaticResource IconHistory}" Checked="Nav_Checked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource ContentBrush}">
            <!-- Home banner: the theme's drawn backdrop, the key-art video over it if the theme allows one -->
            <Grid x:Name="Backdrop" Height="{x:Static local:HomePage.BannerHeight}" VerticalAlignment="Top" ClipToBounds="True">
                <ContentControl Template="{DynamicResource BackdropTemplate}" IsHitTestVisible="False" />
                <MediaElement x:Name="BackdropVideo" Stretch="UniformToFill" IsMuted="True" LoadedBehavior="Manual"
                              UnloadedBehavior="Stop" MediaEnded="BackdropVideo_MediaEnded" MediaFailed="BackdropVideo_MediaFailed" />
                <!-- Vignette keeps the banner text readable and fades into the page -->
                <Rectangle IsHitTestVisible="False" Fill="{DynamicResource VignetteBrush}" />
            </Grid>

            <ContentControl x:Name="Page" Focusable="False" />
        </Grid>
    </Grid>
</Window>
