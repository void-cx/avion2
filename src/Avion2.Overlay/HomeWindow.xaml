<Window x:Class="Avion2.Overlay.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Avion2.Overlay"
        Title="AVION2"
        ThemeMode="Dark"
        Width="1280" Height="800" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ContentBrush}"
        FontFamily="{DynamicResource BodyFont}" FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="76" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Icon rail -->
        <Border Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel x:Name="Rail">
                <Image DockPanel.Dock="Top" Source="{DynamicResource RailLogo}" Width="40" Height="40" Margin="0,18,0,18"
                       RenderOptions.BitmapScalingMode="HighQuality" ToolTip="AVION2" />
                <RadioButton DockPanel.Dock="Bottom" Style="{StaticResource RailButton}" Content="Settings" Tag="settings" GroupName="Nav"
                             local:Ui.Icon="{StaticResource IconSettings}" Checked="Nav_Checked" Margin="0,0,0,8" />
                <Ellipse x:Name="NavDot" DockPanel.Dock="Bottom" Width="8" Height="8" Margin="0,0,0,10" Fill="{DynamicResource IdleBrush}"
                         ToolTip="{Binding Text, Source={x:Static local:ShellStatus.Current}}" />
                <!-- Whose gear, fights, runs and legion the pages show -->
                <!-- (stretched: the Fluent theme's buttons align left) -->
                <Button x:Name="CharacterPick" DockPanel.Dock="Bottom" Height="70" Margin="0,0,0,6" Cursor="Hand" FocusVisualStyle="{x:Null}"
                        HorizontalAlignment="Stretch" MinWidth="0" Padding="0"
                        Foreground="{DynamicResource MutedBrush}" Click="CharacterPick_Click" Visibility="Collapsed">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Border x:Name="Fill" Background="{DynamicResource RailActiveBrush}" Opacity="0" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border x:Name="Ring" Width="34" Height="34" CornerRadius="17" BorderThickness="1.5" HorizontalAlignment="Center"
                                            BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource PaneBrush}">
                                        <Grid>
                                            <Image x:Name="PickIcon" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <!-- the character's portrait from the official site, when there is one (not in streamer mode) -->
                                            <Ellipse x:Name="PickPortrait" Width="31" Height="31" Visibility="Collapsed" />
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="PickName" FontSize="10" Margin="0,5,0,0" MaxWidth="68" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                                </StackPanel>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fill" Property="Opacity" Value="1" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                </Trigger>
                                <Trigger Property="Tag" Value="other">
                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <!-- the pages: the buttons get lower when the window is, and scroll (mouse wheel) below that -->
                <ScrollViewer x:Name="NavScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly" Focusable="False" SizeChanged="NavScroll_SizeChanged">
                <StackPanel x:Name="NavStack">
                    <RadioButton Style="{StaticResource RailButton}" Content="Home" Tag="home" GroupName="Nav"
                                 local:Ui.Icon="{StaticResource IconHome}" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource RailButton}" Content="Timers" Tag="timers" GroupName="Nav"
                                 local:Ui.Icon="{StaticResource IconTimers}" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource RailButton}" Content="Map" Tag="map" GroupName="Nav"
                                 local:Ui.Icon="{StaticResource IconMap}" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource RailButton}" Content="Characters" Tag="characters" GroupName="Nav"
                                 local:Ui.Icon="{StaticResource IconCharacter}" Checked="Nav_Checked"
                                 ToolTip="Your characters and anyone else's: combat power, item level, gear" />
                    <RadioButton Style="{StaticResource RailButton}" Content="Legions" Tag="legions" GroupName="Nav"
                                 local:Ui.Icon="{StaticResource IconLegion}" Checked="Nav_Checked"
                                 ToolTip="Legions compared: the legions seen around you, by combat power or members" />
                    <RadioButton Style="{StaticResource RailButton}" Content="Forge" Tag="forge" GroupName="Nav"
                                 local:Ui.Icon="{StaticResource IconForge}" Checked="Nav_Checked" ToolTip="Gear Forge" />
                    <RadioButton Style="{StaticResource RailButton}" Content="Runs" Tag="runs" GroupName="Nav"
                                 local:Ui.Icon="{StaticResource IconDungeon}" Checked="Nav_Checked" ToolTip="Dungeon runs" />
                    <RadioButton Style="{StaticResource RailButton}" Content="History" Tag="history" GroupName="Nav"
                                 local:Ui.Icon="{StaticResource IconHistory}" Checked="Nav_Checked" />
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource ContentBrush}">
            <!-- Home banner: the theme's drawn backdrop, the key-art video over it if the theme allows one -->
            <Grid x:Name="Backdrop" Height="{x:Static local:HomePage.BannerHeight}" VerticalAlignment="Top" ClipToBounds="True">
                <ContentControl Template="{DynamicResource BackdropTemplate}" IsHitTestVisible="False" />
                <MediaElement x:Name="BackdropVideo" Stretch="UniformToFill" IsMuted="True" LoadedBehavior="Manual"
                              UnloadedBehavior="Stop" MediaEnded="BackdropVideo_MediaEnded" MediaFailed="BackdropVideo_MediaFailed" />
                <!-- Vignette keeps the banner text readable and fades into the page -->
                <Rectangle IsHitTestVisible="False" Fill="{DynamicResource VignetteBrush}" />
            </Grid>

            <ContentControl x:Name="Page" Focusable="False" />
        </Grid>
    </Grid>
</Window>
