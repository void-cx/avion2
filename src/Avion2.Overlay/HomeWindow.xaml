<Window x:Class="Avion2.Overlay.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AVION2"
        ThemeMode="Dark"
        Width="1280" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackdropBrush}"
        FontFamily="{DynamicResource BodyFont}" FontSize="12">
    <Grid>
        <!-- Backdrop: the theme's drawn backdrop, the key-art video over it if the theme allows one -->
        <Grid x:Name="Backdrop" ClipToBounds="True">
            <ContentControl Template="{DynamicResource BackdropTemplate}" IsHitTestVisible="False" />
            <MediaElement x:Name="BackdropVideo" Stretch="UniformToFill" IsMuted="True" LoadedBehavior="Manual"
                          UnloadedBehavior="Stop" MediaEnded="BackdropVideo_MediaEnded" MediaFailed="BackdropVideo_MediaFailed" />
            <!-- Vignette keeps text readable -->
            <Rectangle IsHitTestVisible="False" Fill="{DynamicResource VignetteBrush}" />
            <!-- Inner pages dim the backdrop -->
            <Rectangle x:Name="Dim" Fill="{DynamicResource DimBrush}" Opacity="0" IsHitTestVisible="False" />
        </Grid>

        <DockPanel>
            <!-- Top navigation -->
            <Grid DockPanel.Dock="Top" Height="58" Background="{DynamicResource NavBarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource DividerBrush}" />

                <ContentControl Template="{DynamicResource BrandTemplate}" Margin="24,0,36,0" VerticalAlignment="Center" Focusable="False" />

                <StackPanel x:Name="NavLinks" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{DynamicResource NavLink}" Content="Home" Tag="home" GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton Style="{DynamicResource NavLink}" Content="Timers" Tag="timers" GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton Style="{DynamicResource NavLink}" Content="Gear Forge" Tag="forge" GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton Style="{DynamicResource NavLink}" Content="History" Tag="history" GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton Style="{DynamicResource NavLink}" Content="Settings" Tag="settings" GroupName="Nav" Checked="Nav_Checked" />
                </StackPanel>

                <Border Grid.Column="2" Margin="0,0,20,0" VerticalAlignment="Center" Padding="12,5" CornerRadius="14"
                        Background="{DynamicResource StatusPillBackground}" BorderBrush="{DynamicResource StatusPillBorder}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="NavDot" Width="8" Height="8" Fill="{DynamicResource IdleBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="NavStatus" Text="Meter stopped" Foreground="{DynamicResource NavTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <ContentControl x:Name="Page" />
        </DockPanel>
    </Grid>
</Window>
