<Window x:Class="Avion2.Overlay.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/AVION2;component/Assets/avion2.ico"
        Title="AVION2"
        ThemeMode="Dark"
        Width="1280" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AionNightBrush}"
        FontFamily="Segoe UI" FontSize="12">
    <Grid>
        <!-- Backdrop: key-art video if available, else an aether gradient -->
        <Grid x:Name="Backdrop" ClipToBounds="True">
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.35" GradientOrigin="0.5,0.3" RadiusX="0.75" RadiusY="0.9">
                        <GradientStop Color="#2A6F96" Offset="0" />
                        <GradientStop Color="#123A55" Offset="0.35" />
                        <GradientStop Color="#0B1727" Offset="0.75" />
                        <GradientStop Color="#070D18" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Ellipse Width="220" Height="220" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,140,0,0" Opacity="0.35">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#9ADFFF" Offset="0" />
                        <GradientStop Color="#007FD8FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <MediaElement x:Name="BackdropVideo" Stretch="UniformToFill" IsMuted="True" LoadedBehavior="Manual"
                          UnloadedBehavior="Stop" MediaEnded="BackdropVideo_MediaEnded" MediaFailed="BackdropVideo_MediaFailed" />
            <!-- Vignette keeps text readable -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#E6070D18" Offset="0" />
                        <GradientStop Color="#40070D18" Offset="0.18" />
                        <GradientStop Color="#33070D18" Offset="0.45" />
                        <GradientStop Color="#D9070D18" Offset="0.78" />
                        <GradientStop Color="#FA070D18" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- Inner pages dim the backdrop to an armory-style dark -->
            <Rectangle x:Name="Dim" Fill="#070D18" Opacity="0" IsHitTestVisible="False" />
        </Grid>

        <DockPanel>
            <!-- Site-style top navigation -->
            <Grid DockPanel.Dock="Top" Height="58">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#CC050A13" Offset="0" />
                        <GradientStop Color="#80050A13" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Fill="{StaticResource AionDividerBrush}" />

                <StackPanel Orientation="Horizontal" Margin="24,0,36,0" VerticalAlignment="Center">
                    <Path Style="{StaticResource AionStar}" Width="14" Height="14" Margin="0,0,10,0" />
                    <TextBlock Text="AVION2" FontFamily="{StaticResource AionDisplayFont}" FontSize="22" Foreground="White"
                               Effect="{StaticResource AionGlow}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="NavLinks" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource AionNavLink}" Content="Home" Tag="home" GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource AionNavLink}" Content="History" Tag="history" GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource AionNavLink}" Content="Settings" Tag="settings" GroupName="Nav" Checked="Nav_Checked" />
                </StackPanel>

                <Border Grid.Column="2" Margin="0,0,20,0" VerticalAlignment="Center" Padding="12,5" CornerRadius="14"
                        Background="#99050A13" BorderBrush="#334A6E91" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="NavDot" Width="8" Height="8" Fill="#6B7280" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="NavStatus" Text="Meter stopped" Foreground="#D6E2EE" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <ContentControl x:Name="Page" />
        </DockPanel>
    </Grid>
</Window>
