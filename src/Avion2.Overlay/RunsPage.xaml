<UserControl x:Class="Avion2.Overlay.RunsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Avion2.Overlay">
    <UserControl.Resources>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
        <Style x:Key="NumberCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" MinWidth="380" />
            <ColumnDefinition Width="384" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: content types and best times -->
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,26,22,18">
                    <TextBlock Style="{StaticResource BrandTitle}" />
                    <TextBlock Text="Passive DPS meter for AION2" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <TextBox x:Name="Search" DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Margin="16,0,16,14"
                         local:Ui.Placeholder="Search dungeons, bosses" TextChanged="Search_TextChanged" />
                <local:SidebarFooter DockPanel.Dock="Bottom" />
                <StackPanel x:Name="Views" Margin="8,0">
                    <RadioButton x:Name="AllView" Style="{StaticResource SideItem}" Content="All runs" Tag="all" GroupName="RunView" IsChecked="True"
                                 local:Ui.Icon="{StaticResource IconList}" Checked="View_Checked" />
                    <RadioButton x:Name="BestView" Style="{StaticResource SideItem}" Content="Best times" Tag="best" GroupName="RunView"
                                 local:Ui.Icon="{StaticResource IconStar}" Checked="View_Checked"
                                 ToolTip="Your fastest run per dungeon, among the runs with the most bosses killed there" />
                    <TextBlock Text="CONTENT" Style="{StaticResource SectionLabel}" Margin="14,20,0,8" />
                    <RadioButton Style="{StaticResource SideItem}" Content="Sealed Dungeons" Tag="sealed" GroupName="RunView"
                                 local:Ui.Icon="{StaticResource IconShield}" Checked="View_Checked" />
                    <RadioButton Style="{StaticResource SideItem}" Content="Expeditions" Tag="expedition" GroupName="RunView"
                                 local:Ui.Icon="{StaticResource IconCrown}" Checked="View_Checked" ToolTip="Expeditions, party dungeons and raids" />
                    <RadioButton Style="{StaticResource SideItem}" Content="Strongholds" Tag="stronghold" GroupName="RunView"
                                 local:Ui.Icon="{StaticResource IconRift}" Checked="View_Checked" />
                    <RadioButton Style="{StaticResource SideItem}" Content="Other instances" Tag="other" GroupName="RunView"
                                 local:Ui.Icon="{StaticResource IconDungeon}" Checked="View_Checked"
                                 ToolTip="Ascension instances, trials, arenas and places AVION2 does not know yet" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Runs -->
        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Margin="28,26,28,0">
                <TextBlock Text="Dungeon Runs" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="Hint" Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <!-- The run in progress -->
            <Border x:Name="LiveCard" DockPanel.Dock="Top" Style="{StaticResource SurfaceCard}" Margin="28,16,28,0" Padding="16,12"
                    Cursor="Hand" MouseLeftButtonUp="LiveCard_Click" Visibility="Collapsed" ToolTip="Show the run in progress">
                <DockPanel>
                    <TextBlock x:Name="LiveClock" DockPanel.Dock="Right" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TitleBrush}" />
                    <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Fill="{DynamicResource LiveBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock x:Name="LiveTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="LiveDetail" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top" Margin="28,16,28,0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="0,0,0,8">
                    <StackPanel x:Name="Periods" DockPanel.Dock="Right" Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="Today" Tag="1" GroupName="RunPeriod" Checked="Period_Checked" />
                        <RadioButton Style="{StaticResource Segment}" Content="This week" Tag="7" GroupName="RunPeriod" Checked="Period_Checked" />
                        <RadioButton Style="{StaticResource Segment}" Content="All" Tag="0" GroupName="RunPeriod" IsChecked="True" Checked="Period_Checked" />
                    </StackPanel>
                    <TextBlock x:Name="Shown" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Grid DockPanel.Dock="Top" Margin="38,12,38,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="WHEN" Style="{StaticResource SectionLabel}" />
                <TextBlock Grid.Column="1" Text="DUNGEON" Style="{StaticResource SectionLabel}" />
                <TextBlock Grid.Column="2" Text="TIME" Style="{StaticResource SectionLabel}" TextAlignment="Right" />
                <TextBlock Grid.Column="3" Text="BOSSES" Style="{StaticResource SectionLabel}" TextAlignment="Right" />
                <TextBlock Grid.Column="4" Text="DEATHS" Style="{StaticResource SectionLabel}" TextAlignment="Right" />
            </Grid>
            <Grid>
                <ListBox x:Name="RunList" Style="{StaticResource PlainList}" local:Ui.Count=" runs" ItemContainerStyle="{StaticResource ListRow}" Margin="18,0,18,8"
                         SelectionMode="Extended" SelectionChanged="RunList_SelectionChanged" KeyDown="RunList_KeyDown">
                    <ListBox.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource ListGroupHeader}" />
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="local:RunRow">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="When" Text="{Binding Time}" Style="{StaticResource Cell}" Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Cell}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0">
                                    <Run Text="{Binding Title, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" />  <Run Text="{Binding Extra, Mode=OneWay}" Foreground="{DynamicResource SectionLabelBrush}" />
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="{Binding Duration}" Style="{StaticResource NumberCell}" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding Bosses}" Style="{StaticResource NumberCell}" />
                                <TextBlock Grid.Column="4" Text="{Binding Deaths}" Style="{StaticResource NumberCell}" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <!-- Best times are not grouped by day: show the date -->
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="best">
                                    <Setter TargetName="When" Property="Text" Value="{Binding ShortDate}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="NoRuns" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" Visibility="Collapsed" />
            </Grid>
        </DockPanel>

        <!-- Selected run -->
        <Border Grid.Column="2" Background="{DynamicResource PaneBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <TextBlock x:Name="Empty" Text="Select a run to see its details." Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <DockPanel x:Name="Pane" Visibility="Collapsed">
                    <StackPanel x:Name="Actions" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="22,14,22,22">
                        <Button Style="{StaticResource AccentButton}" Content="Fights" Width="120" Click="Fights_Click"
                                ToolTip="The fights of this run in the Fight History" />
                        <Button Style="{StaticResource QuietButton}" Content="Rename" Margin="10,0,0,0" Click="Rename_Click"
                                ToolTip="Give this place a name (all runs here)" />
                        <Button Style="{StaticResource QuietButton}" local:Ui.Icon="{StaticResource IconCopy}" Width="40" Padding="0" Margin="10,0,0,0"
                                Click="Copy_Click" ToolTip="Copy the run as text, e.g. for chat" />
                        <Button Style="{StaticResource QuietButton}" local:Ui.Icon="{StaticResource IconTrash}" Width="40" Padding="0" Margin="10,0,0,0"
                                Click="Delete_Click" ToolTip="Delete the selected runs (Del)" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="22,24,22,0">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource PaneTitle}" TextWrapping="Wrap" />
                            <TextBox x:Name="RenameBox" Style="{StaticResource SearchBox}" Margin="0,8,0,0" Visibility="Collapsed"
                                     local:Ui.Placeholder="Name for this place (empty = automatic)" KeyDown="RenameBox_KeyDown" LostFocus="RenameBox_LostFocus" />
                            <TextBlock Text="{Binding Where}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                            <WrapPanel Margin="0,10,0,4">
                                <Border Style="{StaticResource AccentPill}"><TextBlock Text="{Binding Category}" /></Border>
                                <Border Style="{StaticResource Pill}"><TextBlock Text="{Binding PartyText}" /></Border>
                                <Border Style="{StaticResource Pill}"><TextBlock Text="{Binding When}" /></Border>
                                <Border Style="{StaticResource Pill}"><TextBlock Text="{Binding Ending}" /></Border>
                            </WrapPanel>

                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,14,0,0">
                                <UniformGrid Columns="4">
                                    <StackPanel><TextBlock Text="Time" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Duration}" Style="{StaticResource StatValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Best" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding BestTime}" Style="{StaticResource StatValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Bosses" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding BossCount}" Style="{StaticResource StatValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Deaths" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding DeathCount}" Style="{StaticResource StatValue}" /></StackPanel>
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="{Binding BestNote}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0" />

                            <UniformGrid Columns="4" Margin="0,14,0,0">
                                <StackPanel><TextBlock Text="Runs here" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Attempts}" Style="{StaticResource StatValue}" /></StackPanel>
                                <StackPanel><TextBlock Text="Fights" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Fights}" Style="{StaticResource StatValue}" /></StackPanel>
                                <StackPanel><TextBlock Text="Your damage" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Damage}" Style="{StaticResource StatValue}" /></StackPanel>
                                <StackPanel><TextBlock Text="Kinah" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Kinah}" Style="{StaticResource StatValue}" /></StackPanel>
                            </UniformGrid>

                            <StackPanel Visibility="{Binding MomentsVisibility}">
                                <TextBlock Text="BOSSES AND DEATHS" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />
                                <ItemsControl ItemsSource="{Binding Moments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding At}" Width="52" Foreground="{DynamicResource MutedBrush}" />
                                                <Rectangle DockPanel.Dock="Left" Width="3" Height="16" Fill="{Binding Accent}" RadiusX="1.5" RadiusY="1.5" Margin="0,0,10,0" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Split}" Foreground="{Binding SplitBrush}" FontWeight="SemiBold"
                                                           Width="52" TextAlignment="Right" VerticalAlignment="Center" ToolTip="Compared with your best run here" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Text="{Binding Missing}" Visibility="{Binding MissingVisibility}" Foreground="{DynamicResource MutedBrush}"
                                       FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />

                            <StackPanel Visibility="{Binding PartyVisibility}">
                                <TextBlock Text="PARTY" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />
                                <ItemsControl ItemsSource="{Binding Party}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,7">
                                                <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,10,0"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ClassName}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Visibility="{Binding LootVisibility}" Margin="0,0,0,12">
                                <TextBlock Text="LOOT" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />
                                <ItemsControl ItemsSource="{Binding Loot}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
