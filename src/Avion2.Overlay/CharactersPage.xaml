<UserControl x:Class="Avion2.Overlay.CharactersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Avion2.Overlay">
    <UserControl.Resources>
        <DataTemplate x:Key="CharacterRowTemplate">
            <DockPanel Margin="0,3">
                <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel>
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- A gear, skin or skill card: icon, name in its grade color, a line below -->
        <DataTemplate x:Key="CardTemplate">
            <Border Margin="0,0,10,10" Padding="10,8" CornerRadius="6" BorderThickness="1" BorderBrush="{Binding Border}"
                    Background="{DynamicResource SurfaceBrush}" ToolTip="{Binding Tip}" Opacity="{Binding Opacity}">
                <DockPanel>
                    <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Foreground="{Binding Brush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Line}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Cards in groups ("Weapons", "Armor", …), three to a row -->
        <DataTemplate x:Key="GroupTemplate">
            <Border Background="{DynamicResource PaneBrush}" CornerRadius="10" Padding="16,12,6,4" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TitleBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3" VerticalAlignment="Top" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- A toggle drawn as a small card: the sheet's tabs and the Daevanion boards -->
        <Style x:Key="CardToggle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" Background="{DynamicResource PaneBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TitleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SheetTab" TargetType="RadioButton" BasedOn="{StaticResource CardToggle}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="0,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="GroupName" Value="SheetTab" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: own characters, look up anyone -->
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,26,22,18">
                    <TextBlock Style="{StaticResource BrandTitle}" />
                    <TextBlock Text="Passive DPS meter for AION2" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,0,16,0">
                    <TextBox x:Name="NameBox" Style="{StaticResource SearchBox}" local:Ui.Placeholder="Look up a player" KeyDown="NameBox_KeyDown" />
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" local:Ui.Icon="{StaticResource IconSearch}" Width="40" Padding="0"
                                Margin="8,0,0,0" Click="Search_Click" ToolTip="Search this server" />
                        <ComboBox x:Name="ServerBox" DisplayMemberPath="Label" ToolTip="The player's server" />
                    </DockPanel>
                </StackPanel>
                <local:SidebarFooter DockPanel.Dock="Bottom" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,14,8,0">
                    <StackPanel>
                        <StackPanel x:Name="ResultsPanel" Visibility="Collapsed">
                            <TextBlock x:Name="ResultsLabel" Text="RESULTS" Style="{StaticResource SectionLabel}" Margin="14,0,0,6" />
                            <ListBox x:Name="Results" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource ListRow}"
                                     ItemTemplate="{StaticResource CharacterRowTemplate}" SelectionChanged="List_SelectionChanged" />
                        </StackPanel>
                        <TextBlock Text="YOUR CHARACTERS" Style="{StaticResource SectionLabel}" Margin="14,14,0,6" />
                        <ListBox x:Name="Mine" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource ListRow}"
                                 ItemTemplate="{StaticResource CharacterRowTemplate}" SelectionChanged="List_SelectionChanged" />
                        <TextBlock x:Name="NoneYet" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="14,4,14,0"
                                   Text="Your characters show up here once AVION2 has seen them in game." Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Character sheet -->
        <Grid Grid.Column="1">
            <TextBlock x:Name="Message" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
            <DockPanel x:Name="Sheet" Visibility="Collapsed" MaxWidth="1120" HorizontalAlignment="Stretch">
                <!-- Header: portrait, name, server, class, item level, combat power, titles -->
                <Border DockPanel.Dock="Top" Style="{StaticResource SurfaceCard}" Margin="28,24,28,0" Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="92" Height="104" Margin="0,0,18,0" VerticalAlignment="Top">
                            <Border Height="92" VerticalAlignment="Top" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource LineBrush}"
                                    Background="{DynamicResource PaneBrush}">
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,88,88" RadiusX="8" RadiusY="8" />
                                </Border.Clip>
                                <Image Source="{Binding Portrait}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" MinWidth="40" Padding="8,2" CornerRadius="6"
                                    Background="{DynamicResource PaneHeaderBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding Level}" Foreground="{DynamicResource TitleBrush}" FontWeight="Bold" HorizontalAlignment="Center" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Pill}" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding ServerName}" /></Border>
                                <Button Style="{StaticResource QuietButton}" Content="Refresh" Margin="8,0,0,0" Padding="12,3" VerticalAlignment="Center"
                                        Click="Refresh_Click" ToolTip="Ask the official AION2 site again (it updates when the character logs out or changes zone)" />
                            </StackPanel>
                            <TextBlock x:Name="Updated" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Image Source="{Binding ClassIcon}" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding ClassLine}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Pill}" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="Item level: the average level of the gear worn">
                                    <TextBlock><Run Text="iLvl" Foreground="{DynamicResource MutedBrush}" />  <Run Text="{Binding ItemLevel, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                </Border>
                                <Border Style="{StaticResource AccentPill}" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock><Run Text="CP" />  <Run Text="{Binding CombatPower, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="420">
                            <TextBlock Text="{Binding Legion}" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Titles}" HorizontalAlignment="Right">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Right" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="6,0,0,6" Padding="10,5" CornerRadius="6" BorderThickness="1" BorderBrush="{Binding Border}"
                                                Background="{DynamicResource PaneBrush}" ToolTip="{Binding Tip}">
                                            <TextBlock Text="{Binding Title}" Foreground="{Binding Brush}" FontWeight="SemiBold" MaxWidth="170" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <UniformGrid x:Name="Tabs" DockPanel.Dock="Top" Rows="1" Margin="28,16,20,14">
                    <RadioButton Style="{StaticResource SheetTab}" Content="EQUIPMENT" Tag="equipment" IsChecked="True" Checked="Tab_Checked" />
                    <RadioButton Style="{StaticResource SheetTab}" Content="SKILLS" Tag="skills" Checked="Tab_Checked" />
                    <RadioButton Style="{StaticResource SheetTab}" Content="DAEVANION" Tag="daevanion" Checked="Tab_Checked" />
                    <RadioButton Style="{StaticResource SheetTab}" Content="STATS" Tag="stats" Checked="Tab_Checked" />
                    <RadioButton Style="{StaticResource SheetTab}" Content="COSMETICS" Tag="cosmetics" Checked="Tab_Checked" />
                </UniformGrid>

                <TextBlock DockPanel.Dock="Bottom" Margin="28,0,28,14" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                           Text="From the character page of the official AION2 site, which shows any character on any server." />

                <Grid>
                    <!-- Equipment, skills, cosmetics: groups of cards -->
                    <ScrollViewer x:Name="CardsTab" VerticalScrollBarVisibility="Auto" Padding="28,0,18,0">
                        <ItemsControl x:Name="Groups" ItemTemplate="{StaticResource GroupTemplate}" />
                    </ScrollViewer>

                    <!-- Stats -->
                    <ScrollViewer x:Name="StatsTab" VerticalScrollBarVisibility="Auto" Padding="28,0,18,0" Visibility="Collapsed">
                        <ItemsControl ItemsSource="{Binding StatGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource PaneBrush}" CornerRadius="10" Padding="16,12,6,4" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TitleBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><UniformGrid Columns="3" VerticalAlignment="Top" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,10,10" Padding="12,8" CornerRadius="6" BorderThickness="1"
                                                                BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource SurfaceBrush}">
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Foreground="{DynamicResource TitleBrush}" FontWeight="Bold" FontSize="15" />
                                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding Effects}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Daevanion: one board at a time, its open effects beside it -->
                    <DockPanel x:Name="DaevanionTab" Margin="28,0,28,8" Visibility="Collapsed">
                        <ItemsControl x:Name="Boards" DockPanel.Dock="Top" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource CardToggle}" GroupName="Board" Tag="{Binding Id}" Margin="0,0,8,8" Padding="14,6"
                                                 Checked="Board_Checked" IsChecked="{Binding Selected, Mode=OneTime}">
                                        <StackPanel MinWidth="70">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Count}" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                                            <ProgressBar Style="{StaticResource ThinBar}" Value="{Binding Fraction, Mode=OneWay}" Maximum="1" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border DockPanel.Dock="Right" Width="250" Margin="14,0,0,0" Background="{DynamicResource PaneBrush}" CornerRadius="10" Padding="14,12">
                            <DockPanel>
                                <TextBlock x:Name="EffectsTitle" DockPanel.Dock="Top" Foreground="{DynamicResource TitleBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="Effects" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Border Background="{DynamicResource PaneBrush}" CornerRadius="10" Padding="12">
                            <Grid>
                                <Viewbox Stretch="Uniform" MaxHeight="560">
                                    <UniformGrid x:Name="BoardGrid" Rows="15" Columns="15" Width="510" Height="510" />
                                </Viewbox>
                                <TextBlock x:Name="BoardMessage" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
