<UserControl x:Class="Avion2.Overlay.DetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Avion2.Overlay">
    <UserControl.Resources>
        <!-- Stat tile -->
        <DataTemplate x:Key="TileTemplate">
            <Border Margin="0,0,6,6" Padding="10,6" MinWidth="104" CornerRadius="6" Background="{DynamicResource TileBackgroundBrush}" BorderBrush="{DynamicResource TileBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Opacity="0.7" FontSize="11" />
                    <TextBlock x:Name="Value" Text="{Binding Value}" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="accent"><Setter TargetName="Value" Property="Foreground" Value="#4ADE80" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="crit"><Setter TargetName="Value" Property="Foreground" Value="#F472B6" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="back"><Setter TargetName="Value" Property="Foreground" Value="#22D3EE" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="double"><Setter TargetName="Value" Property="Foreground" Value="#FACC15" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="perfect"><Setter TargetName="Value" Property="Foreground" Value="#34D399" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="hp"><Setter TargetName="Value" Property="Foreground" Value="#F87171" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="Right" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="Crit" TargetType="TextBlock" BasedOn="{StaticResource Right}"><Setter Property="Foreground" Value="#F472B6" /></Style>
        <Style x:Key="Back" TargetType="TextBlock" BasedOn="{StaticResource Right}"><Setter Property="Foreground" Value="#22D3EE" /></Style>
        <Style x:Key="Double" TargetType="TextBlock" BasedOn="{StaticResource Right}"><Setter Property="Foreground" Value="#FACC15" /></Style>
        <Style x:Key="Perfect" TargetType="TextBlock" BasedOn="{StaticResource Right}"><Setter Property="Foreground" Value="#34D399" /></Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header: the fight, the views, the player and the pin -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Height="64" Margin="20,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Target}" FontFamily="{DynamicResource DisplayFont}" FontWeight="{DynamicResource DisplayWeight}" FontSize="20"
                               Foreground="{DynamicResource TitleBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Trace.NetSummary}" />
                </StackPanel>
                <StackPanel x:Name="TabLinks" Grid.Column="1" Orientation="Horizontal" Margin="16,0,8,0">
                    <RadioButton Style="{StaticResource TabLink}" Content="Replay" Tag="4" GroupName="FightTab" Checked="TabLink_Checked" Height="64" Margin="0,0,20,0" />
                    <RadioButton Style="{StaticResource TabLink}" Content="Damage dealt" Tag="0" GroupName="FightTab" Checked="TabLink_Checked" Height="64" Margin="0,0,20,0" />
                    <RadioButton Style="{StaticResource TabLink}" Content="Damage taken" Tag="1" GroupName="FightTab" Checked="TabLink_Checked" Height="64" Margin="0,0,20,0" />
                    <RadioButton Style="{StaticResource TabLink}" Content="Buffs" Tag="3" GroupName="FightTab" Checked="TabLink_Checked" Height="64" Margin="0,0,20,0" />
                    <RadioButton Style="{StaticResource TabLink}" Content="Timeline" Tag="2" GroupName="FightTab" Checked="TabLink_Checked" Height="64" Margin="0" />
                </StackPanel>
                <ComboBox Grid.Column="2" Width="210" Margin="12,0" VerticalAlignment="Center" ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer}"
                          DisplayMemberPath="Label" ToolTip="Whose numbers the tables show" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Pill}" Margin="0" VerticalAlignment="Center"><TextBlock Text="{Binding Source}" /></Border>
                    <ToggleButton x:Name="PinButton" Visibility="Collapsed" Margin="10,0,0,0" Style="{StaticResource QuietToggle}" local:Ui.Icon="{StaticResource IconPin}"
                                  ToolTip="Keep this window on top of the game" Checked="Pin_Changed" Unchecked="Pin_Changed" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="Tabs" SelectedIndex="{Binding TabIndex}" Background="Transparent" BorderThickness="0" Padding="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <ContentPresenter ContentSource="SelectedContent" />
                </ControlTemplate>
            </TabControl.Template>
            <TabItem Header="Damage dealt">
                <Grid Margin="16,6,16,16">
                <DockPanel Margin="0,10,0,0">
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource TileTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <DataGrid Background="{DynamicResource GridBackgroundBrush}" BorderBrush="{DynamicResource GridBorderBrush}" ItemsSource="{Binding Skills}" Margin="0,4,0,0" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" CanUserResizeRows="False" RowHeight="28" HorizontalScrollBarVisibility="Auto" CanUserResizeColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Skill" Binding="{Binding Name}" Width="*" MinWidth="160" />
                            <DataGridTemplateColumn Header="Spec" Width="70" MinWidth="70" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Spec}" VerticalAlignment="Center"
                                                      ToolTip="Specialisation slots (from the skill id)">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Ellipse x:Name="Dot" Width="6" Height="6" Margin="1.5,0" Fill="#4D9AA3B2" />
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="True">
                                                            <Setter TargetName="Dot" Property="Fill" Value="#22D3EE" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Hits" Binding="{Binding Hits}" Width="56" MinWidth="56" ElementStyle="{StaticResource Right}" />
                            <DataGridTextColumn Header="Crit" Binding="{Binding Crit, StringFormat={}{0:P1}}" Width="66" MinWidth="66" ElementStyle="{StaticResource Crit}" />
                            <DataGridTextColumn Header="Back" Binding="{Binding Back, StringFormat={}{0:P1}}" Width="66" MinWidth="66" ElementStyle="{StaticResource Back}" />
                            <DataGridTextColumn Header="Double" Binding="{Binding Double, StringFormat={}{0:P1}}" Width="70" MinWidth="70" ElementStyle="{StaticResource Double}" />
                            <DataGridTextColumn Header="Perfect" Binding="{Binding Perfect, StringFormat={}{0:P1}}" Width="70" MinWidth="70" ElementStyle="{StaticResource Perfect}" />
                            <DataGridTextColumn Header="Parried" Binding="{Binding Parry, StringFormat={}{0:P1}}" Width="70" MinWidth="70" ElementStyle="{StaticResource Right}" />
                            <DataGridTextColumn Header="Multi" Binding="{Binding Multi, StringFormat={}{0:P1}}" Width="66" MinWidth="66" ElementStyle="{StaticResource Right}" />
                            <DataGridTextColumn Header="Multi dmg" Binding="{Binding MultiDamage, StringFormat={}{0:N0}}" Width="84" MinWidth="84" ElementStyle="{StaticResource Right}" />
                            <DataGridTextColumn Header="Average" Binding="{Binding Average, StringFormat={}{0:N0}}" Width="80" MinWidth="80" ElementStyle="{StaticResource Right}" />
                            <DataGridTextColumn Header="Min" Binding="{Binding Min, StringFormat={}{0:N0}}" Width="72" MinWidth="72" ElementStyle="{StaticResource Right}" />
                            <DataGridTextColumn Header="Max" Binding="{Binding Max, StringFormat={}{0:N0}}" Width="80" MinWidth="80" ElementStyle="{StaticResource Right}" />
                            <DataGridTemplateColumn Header="Total" Width="190" MinWidth="190" SortMemberPath="Total" SortDirection="Descending">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,3">
                                            <Border Background="#594DB6AC" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding Share}" />
                                                </Border.RenderTransform>
                                            </Border>
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FACC15">
                                                <Run Text="{Binding Total, StringFormat={}{0:N0}, Mode=OneWay}" />
                                                <Run Text="{Binding Share, StringFormat={} ({0:P1}), Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Damage taken">
                <Grid Margin="16,6,16,16">
                <DockPanel Margin="0,10,0,0">
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding TakenTiles}" ItemTemplate="{StaticResource TileTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <DataGrid Background="{DynamicResource GridBackgroundBrush}" BorderBrush="{DynamicResource GridBorderBrush}" ItemsSource="{Binding Sources}" Margin="0,4,0,0" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" CanUserResizeRows="False" RowHeight="28" HorizontalScrollBarVisibility="Auto" CanUserResizeColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Attacker" Binding="{Binding Attacker}" Width="*" MinWidth="160" />
                            <DataGridTextColumn Header="Skill" Binding="{Binding Skill}" Width="*" MinWidth="140" />
                            <DataGridTextColumn Header="Hits" Binding="{Binding Hits}" Width="60" MinWidth="60" ElementStyle="{StaticResource Right}" />
                            <DataGridTextColumn Header="Crits" Binding="{Binding Crits}" Width="60" MinWidth="60" ElementStyle="{StaticResource Crit}" />
                            <DataGridTextColumn Header="Average" Binding="{Binding Average, StringFormat={}{0:N0}}" Width="84" MinWidth="84" ElementStyle="{StaticResource Right}" />
                            <DataGridTextColumn Header="Max" Binding="{Binding Max, StringFormat={}{0:N0}}" Width="84" MinWidth="84" ElementStyle="{StaticResource Right}" />
                            <DataGridTemplateColumn Header="Total" Width="190" MinWidth="190" SortMemberPath="Total" SortDirection="Descending">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,3">
                                            <Border Background="#59C04545" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding Share}" />
                                                </Border.RenderTransform>
                                            </Border>
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FCA5A5">
                                                <Run Text="{Binding Total, StringFormat={}{0:N0}, Mode=OneWay}" />
                                                <Run Text="{Binding Share, StringFormat={} ({0:P1}), Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Timeline">
                <Grid Margin="16,6,16,16">
                <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Top" Opacity="0.7" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"
                               Text="Every skill cast, per player (summons count for their owner), with the main target's HP behind. Hover a mark for the skill." />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <local:TimelineView x:Name="Timeline" Trace="{Binding Trace}" SelectedActor="{Binding SelectedActorId}" />
                    </ScrollViewer>
                </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Buffs">
                <Grid Margin="16,6,16,16">
                <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Top" Opacity="0.7" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"
                               Text="Buffs and debuffs on the selected player: share of the fight they were up, how often they were applied, and by whom." />
                    <DataGrid Background="{DynamicResource GridBackgroundBrush}" BorderBrush="{DynamicResource GridBorderBrush}" ItemsSource="{Binding BuffLines}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                              CanUserResizeRows="False" RowHeight="28">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Effect" Binding="{Binding Name}" Width="*" MinWidth="180" />
                            <DataGridTemplateColumn Header="Uptime" Width="220" MinWidth="160" SortMemberPath="Uptime">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,3">
                                            <Border Background="#594DB6AC" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding Uptime}" />
                                                </Border.RenderTransform>
                                            </Border>
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                                       Text="{Binding Uptime, StringFormat={}{0:P0}}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Applied" Binding="{Binding Applications}" Width="70" ElementStyle="{StaticResource Right}" />
                            <DataGridTextColumn Header="From" Binding="{Binding Caster}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Replay">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <!-- Top-down view -->
                    <Border Background="{DynamicResource StageBrush}">
                        <local:ReplayView x:Name="Replay" Trace="{Binding Trace}" Time="{Binding Value, ElementName=ReplaySlider}"
                                          SelectedActor="{Binding SelectedActorId}" MinHeight="240" Margin="10"
                                          ToolTip="Click a dot for details · wheel: zoom · drag: pan · double-click: fit. Your own position comes from buffs and dashes (the game does not send it continuously); dashed players and faint monsters are estimated positions."
                                          ToolTipService.InitialShowDelay="1500" />
                    </Border>

                    <!-- The meter at the playhead -->
                    <Border Grid.Column="1" Background="{DynamicResource PaneBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
                        <DockPanel Margin="0,16,0,12">
                            <StackPanel DockPanel.Dock="Top" Margin="18,0,18,12">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding BossHpText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                                    <TextBlock Text="{Binding PlayheadLabel}" Style="{StaticResource SectionLabel}" />
                                </DockPanel>
                                <ProgressBar Style="{StaticResource ThinBar}" Value="{Binding BossHp, Mode=OneWay}" Foreground="#E5484D" Height="4" Margin="0,8,0,0"
                                             Visibility="{Binding BossHpText, Converter={StaticResource NotEmpty}}" />
                            </StackPanel>
                            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding PlayheadRows}" Margin="10,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid x:Name="Row" Height="44" Margin="0,0,0,6">
                                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource ShellRadius}" />
                                            <Border Background="{Binding Fill}" CornerRadius="{DynamicResource ShellRadius}" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform><ScaleTransform ScaleX="{Binding Share}" /></Border.RenderTransform>
                                            </Border>
                                            <DockPanel Margin="10,0,12,0">
                                                <Border DockPanel.Dock="Left" Width="4" Height="24" CornerRadius="2" Background="{Binding Color}" Margin="0,0,10,0" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Dps}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TitleBrush}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock DockPanel.Dock="Top" Text="LAST HITS" Style="{StaticResource SectionLabel}" Margin="18,14,18,6"
                                       Visibility="{Binding PlayheadLabel, Converter={StaticResource NotEmpty}}" />
                            <ItemsControl ItemsSource="{Binding RecentHits}" Margin="18,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="28" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="46" FontSize="12" Foreground="{DynamicResource SectionLabelBrush}" VerticalAlignment="Center" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Amount}" FontSize="12" Foreground="{Binding AmountBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{Binding Color}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>

                    <!-- Transport -->
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                        <DockPanel Height="134" Margin="18,14,18,12">
                            <StackPanel DockPanel.Dock="Left" Width="164" Margin="0,0,18,0">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="PlayButton" Style="{StaticResource PlayToggle}" ToolTip="Play / pause (Space)" Checked="Play_Changed" Unchecked="Play_Changed" />
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="Clock" Text="0:00" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}" />
                                        <TextBlock x:Name="Length" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                                    </StackPanel>
                                </StackPanel>
                                <Border BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShellRadius}" Margin="0,14,0,0" Padding="1">
                                    <UniformGrid x:Name="Speeds" Rows="1" ToolTip="Playback speed">
                                        <RadioButton Style="{StaticResource Segment}" Content="½×" Tag="0.5" GroupName="Speed" />
                                        <RadioButton Style="{StaticResource Segment}" Content="1×" Tag="1" GroupName="Speed" IsChecked="True" />
                                        <RadioButton Style="{StaticResource Segment}" Content="2×" Tag="2" GroupName="Speed" />
                                        <RadioButton Style="{StaticResource Segment}" Content="4×" Tag="4" GroupName="Speed" />
                                        <RadioButton Style="{StaticResource Segment}" Content="8×" Tag="8" GroupName="Speed" />
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                            <local:ScrubberView x:Name="ReplaySlider" Trace="{Binding Trace}" Maximum="{Binding TraceLength}" SelectedActor="{Binding SelectedActorId}"
                                                ToolTip="Each mark is a cast · click or drag to jump · red line: the main target's HP" ToolTipService.InitialShowDelay="1500" />
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
