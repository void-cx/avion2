<Window x:Class="Avion2.Overlay.ApplicantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AVION2 Applicant"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" FontFamily="{DynamicResource BodyFont}" FontSize="12">
    <Window.Resources>
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TitleBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PageButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Height" Value="22" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>
        <Style x:Key="TileKey" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Skeleton" TargetType="Border">
            <Setter Property="Height" Value="12" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <!-- Margin leaves room for the glow -->
    <Border Margin="12" CornerRadius="10" Padding="14,10,14,14" Width="300" Background="{DynamicResource NoticeBackground}"
            BorderBrush="{DynamicResource NoticeBorderBrush}" BorderThickness="1" Effect="{DynamicResource NoticeGlow}"
            MouseLeftButtonDown="Card_MouseLeftButtonDown" Cursor="SizeAll">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Chip" Foreground="{DynamicResource ChipTextBrush}" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Text="Join request" />
                <TextBlock x:Name="Timer" Grid.Column="1" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"
                           Margin="8,0,4,0" ToolTip="Until the request runs out" />
                <Button Grid.Column="2" Style="{StaticResource HeaderButton}" Content="&#xE711;" Margin="0,0,-6,0" Click="Close_Click"
                        ToolTip="Hide until the next request" />
            </Grid>

            <Grid x:Name="Expiry" Height="2" Margin="0,8,0,12">
                <Border Background="{DynamicResource TrackBrush}" CornerRadius="1" />
                <Border x:Name="ExpiryFill" Background="{DynamicResource NoticeChipBrush}" CornerRadius="1" HorizontalAlignment="Left" Width="0" />
            </Grid>

            <!-- Who -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="58" Height="58" VerticalAlignment="Top">
                    <Border CornerRadius="8" BorderBrush="{DynamicResource NoticeBorderBrush}" BorderThickness="1" Background="{DynamicResource EmblemFillBrush}">
                        <Grid>
                            <Image x:Name="ClassLarge" Width="34" Height="34" Opacity="0.85" />
                            <Border x:Name="PortraitFrame" CornerRadius="7" Visibility="Collapsed">
                                <Border.Background>
                                    <ImageBrush x:Name="PortraitBrush" Stretch="UniformToFill" AlignmentY="Top" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <Border x:Name="Emblem" Width="24" Height="24" CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,-6,-6" Background="{DynamicResource EmblemFillBrush}" BorderBrush="{DynamicResource NoticeBorderBrush}"
                            BorderThickness="1" Visibility="Collapsed">
                        <Image x:Name="EmblemIcon" Width="16" Height="16" />
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" Foreground="{DynamicResource TitleBrush}" FontFamily="{DynamicResource DisplayFont}" FontSize="17"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SubText" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="LegionText" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!-- Item level and combat power against the room -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border CornerRadius="8" Padding="10,8" Background="{DynamicResource TileBackgroundBrush}" BorderBrush="{DynamicResource TileBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileKey}" Text="ITEM LEVEL" />
                        <TextBlock x:Name="ItemLevelText" Style="{StaticResource TileValue}" />
                        <TextBlock x:Name="ItemLevelVs" FontSize="11" Margin="0,1,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" CornerRadius="8" Padding="10,8" Background="{DynamicResource TileBackgroundBrush}" BorderBrush="{DynamicResource TileBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileKey}" Text="COMBAT POWER" />
                        <TextBlock x:Name="PowerText" Style="{StaticResource TileValue}" />
                        <TextBlock x:Name="PowerVs" FontSize="11" Margin="0,1,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel x:Name="RoomPanel" Margin="0,10,0,0">
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="Item level in your room" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                    <TextBlock x:Name="RoomRange" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" />
                </Grid>
                <Canvas x:Name="Scale" Height="18" ClipToBounds="False" />
            </StackPanel>

            <!-- Gear from the official site -->
            <TextBlock Style="{StaticResource Section}" Text="GEAR (OFFICIAL SITE)" />
            <WrapPanel x:Name="GearPanel" />
            <Grid x:Name="Facts" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>
            <StackPanel x:Name="GearLoading">
                <Border Style="{StaticResource Skeleton}" Width="270" />
                <Border Style="{StaticResource Skeleton}" Width="190" />
            </StackPanel>
            <TextBlock x:Name="GearNote" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap" Visibility="Collapsed" />

            <Border x:Name="SeenBox" Margin="0,10,0,0" Padding="9,7" CornerRadius="6" Background="#127FD8FF" BorderBrush="#2E7FD8FF" BorderThickness="1">
                <TextBlock x:Name="SeenText" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" TextWrapping="Wrap" />
            </Border>

            <Grid Margin="0,12,0,0">
                <Button x:Name="ProfileButton" Style="{StaticResource PillButton}" Content="Full profile" HorizontalAlignment="Left" Click="Profile_Click"
                        ToolTip="Open this character on the Characters page" />
                <StackPanel x:Name="Pager" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="PrevButton" Style="{StaticResource PageButton}" Content="&#xE76B;" Click="Prev_Click" ToolTip="Newer request" />
                    <TextBlock x:Name="PageText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="4,0" />
                    <Button x:Name="NextButton" Style="{StaticResource PageButton}" Content="&#xE76C;" Click="Next_Click" ToolTip="Older request" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
