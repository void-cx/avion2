<UserControl x:Class="Avion2.Overlay.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Avion2.Overlay">
    <UserControl.Resources>
        <!-- When · Fight · Time · Party · Your DPS -->
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
        <Style x:Key="NumberCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" MinWidth="380" />
            <ColumnDefinition Width="384" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,26,22,18">
                    <TextBlock Style="{StaticResource BrandTitle}" />
                    <TextBlock Text="Passive DPS meter for AION2" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <TextBox x:Name="Search" DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Margin="16,0,16,14"
                         local:Ui.Placeholder="Search fights, bosses" TextChanged="Search_TextChanged" />
                <local:SidebarFooter DockPanel.Dock="Bottom" />
                <StackPanel Margin="8,0">
                    <RadioButton x:Name="AllMode" Style="{StaticResource SideItem}" Content="All fights" GroupName="HistoryMode" IsChecked="True"
                                 local:Ui.Icon="{StaticResource IconList}" Checked="Mode_Checked" />
                    <RadioButton x:Name="BestMode" Style="{StaticResource SideItem}" Content="Best per target" GroupName="HistoryMode"
                                 local:Ui.Icon="{StaticResource IconStar}" Checked="Mode_Checked"
                                 ToolTip="For every boss or named target, the fight where you did the most damage per second (fights of 20 s or more)" />
                    <TextBlock Text="RECORDINGS" Style="{StaticResource SectionLabel}" Margin="14,20,0,8" />
                    <Button Style="{StaticResource SideAction}" Content="Open folder" local:Ui.Icon="{StaticResource IconFolder}" Click="Folder_Click"
                            ToolTip="The saved fights and their replays (JSON files)" />
                    <Button Style="{StaticResource SideAction}" Content="Storage" local:Ui.Icon="{StaticResource IconTrash}" Click="Storage_Click"
                            ToolTip="Automatic cleanup of old fights and recordings (Settings)" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Fights -->
        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Margin="28,26,28,0">
                <TextBlock Text="Fight History" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="Hint" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Border DockPanel.Dock="Top" Margin="28,16,28,0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="0,0,0,8">
                    <StackPanel x:Name="Periods" DockPanel.Dock="Right" Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="Today" Tag="1" GroupName="Period" Checked="Period_Checked" />
                        <RadioButton Style="{StaticResource Segment}" Content="This week" Tag="7" GroupName="Period" Checked="Period_Checked" />
                        <RadioButton Style="{StaticResource Segment}" Content="All" Tag="0" GroupName="Period" IsChecked="True" Checked="Period_Checked" />
                    </StackPanel>
                    <TextBlock x:Name="Shown" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Grid DockPanel.Dock="Top" Margin="38,12,38,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="WHEN" Style="{StaticResource SectionLabel}" />
                <TextBlock Grid.Column="1" Text="FIGHT" Style="{StaticResource SectionLabel}" />
                <TextBlock Grid.Column="2" Text="TIME" Style="{StaticResource SectionLabel}" TextAlignment="Right" />
                <TextBlock Grid.Column="3" Text="PARTY" Style="{StaticResource SectionLabel}" TextAlignment="Right" />
                <TextBlock Grid.Column="4" Text="YOUR DPS" Style="{StaticResource SectionLabel}" TextAlignment="Right" />
            </Grid>
            <Grid>
                <ListBox x:Name="FightList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource ListRow}" Margin="18,0,18,8"
                         SelectionMode="Extended" SelectionChanged="FightList_SelectionChanged" KeyDown="FightList_KeyDown">
                    <ListBox.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource ListGroupHeader}" />
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="local:HistoryRow">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="When" Text="{Binding Time}" Style="{StaticResource Cell}" Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Cell}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0">
                                    <Run Text="{Binding Boss, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" /> <Run Text="{Binding Extra, Mode=OneWay}" Foreground="{DynamicResource SectionLabelBrush}" />
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="{Binding Duration}" Style="{StaticResource NumberCell}" />
                                <TextBlock Grid.Column="3" Text="{Binding Party}" Style="{StaticResource NumberCell}" />
                                <TextBlock Grid.Column="4" Text="{Binding YourDpsFull}" Style="{StaticResource NumberCell}" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <!-- Records are not grouped by day: show the date -->
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="best">
                                    <Setter TargetName="When" Property="Text" Value="{Binding ShortDate}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="NoFights" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" Visibility="Collapsed" />
            </Grid>
        </DockPanel>

        <!-- Selected fight -->
        <Border Grid.Column="2" Background="{DynamicResource PaneBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <TextBlock x:Name="Empty" Text="Select a fight to see its details." Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <DockPanel x:Name="Pane" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Height="150" Background="{DynamicResource PaneHeaderBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                        <local:DpsChart x:Name="Chart" />
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="22,14,22,22">
                        <Button x:Name="ReplayButton" Style="{StaticResource AccentButton}" Content="Watch replay" Width="150" Click="Replay_Click" />
                        <Button Style="{StaticResource QuietButton}" Content="Details" Margin="10,0,0,0" Click="Details_Click"
                                ToolTip="Damage by skill, damage taken, buffs and the timeline" />
                        <Button Style="{StaticResource QuietButton}" local:Ui.Icon="{StaticResource IconCopy}" Width="40" Padding="0" Margin="10,0,0,0"
                                Click="Copy_Click" ToolTip="Copy the fight as text, e.g. for chat" />
                        <Button Style="{StaticResource QuietButton}" local:Ui.Icon="{StaticResource IconTrash}" Width="40" Padding="0" Margin="10,0,0,0"
                                Click="Delete_Click" ToolTip="Delete the selected fights and their replays (Del)" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="22,18,22,0">
                            <TextBlock Text="{Binding Boss}" Style="{StaticResource PaneTitle}" />
                            <WrapPanel Margin="0,10,0,4">
                                <Border Style="{StaticResource AccentPill}" Visibility="{Binding ExtraVisibility}">
                                    <TextBlock Text="{Binding ExtraText}" />
                                </Border>
                                <Border Style="{StaticResource Pill}"><TextBlock Text="{Binding PartyText}" /></Border>
                                <Border Style="{StaticResource Pill}"><TextBlock Text="{Binding WhenText}" /></Border>
                                <Border Style="{StaticResource Pill}"><TextBlock Text="{Binding Ended}" /></Border>
                            </WrapPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ShareText}" Foreground="{DynamicResource TitleBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ShareLabel}" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </DockPanel>
                            <ProgressBar Style="{StaticResource ThinBar}" Value="{Binding Share, Mode=OneWay}" Margin="0,6,0,0" />
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
                                <UniformGrid Columns="4">
                                    <StackPanel><TextBlock Text="{Binding DpsLabel}" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Dps}" Style="{StaticResource StatValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Duration" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Duration}" Style="{StaticResource StatValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Crit" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Crit}" Style="{StaticResource StatValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Hits" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Hits}" Style="{StaticResource StatValue}" /></StackPanel>
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="{Binding SkillsLabel}" Style="{StaticResource SectionLabel}" Margin="0,20,0,8" />
                            <ItemsControl ItemsSource="{Binding Skills}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,9">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Total}" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <ProgressBar Style="{StaticResource ThinBar}" Value="{Binding Share, Mode=OneWay}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
