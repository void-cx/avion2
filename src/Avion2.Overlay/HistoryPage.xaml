<UserControl x:Class="Avion2.Overlay.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Avion2.Overlay">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="260" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Fight History" Style="{DynamicResource CardHeading}" FontSize="28" />
            <TextBlock x:Name="Hint" DockPanel.Dock="Top" Opacity="0.7" FontSize="11" Margin="0,2,0,8" TextWrapping="Wrap" />
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button Content="Copy summary" Margin="0,0,6,0" Click="Copy_Click" IsEnabled="{Binding SelectedItem, ElementName=Grid, Converter={StaticResource NotNull}}"
                        ToolTip="Copy the selected fight as text, e.g. for chat" />
                <Button Content="Delete" Margin="0,0,6,0" Click="Delete_Click" IsEnabled="{Binding SelectedItem, ElementName=Grid, Converter={StaticResource NotNull}}" />
                <Button Content="Open folder" Click="Folder_Click" />
            </WrapPanel>
            <DataGrid x:Name="Grid" Background="{DynamicResource GridBackgroundBrush}" BorderBrush="{DynamicResource GridBorderBrush}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                      SelectionMode="Extended" RowHeight="28" SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="When" Binding="{Binding When}" SortMemberPath="StartedAtMs" Width="112" />
                    <DataGridTextColumn Header="Fight" Binding="{Binding Title}" Width="*" />
                    <DataGridTextColumn Header="Time" Binding="{Binding Duration}" SortMemberPath="Seconds" Width="58" />
                    <DataGridTextColumn Header="You" Binding="{Binding YourDps}" SortMemberPath="YourDpsValue" Width="64" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

        <Border Grid.Column="2" Margin="8,0,0,0" Style="{DynamicResource Panel}">
        <Grid>
            <TextBlock x:Name="Empty" Text="Select a fight to see its details." Opacity="0.6"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <local:DetailView x:Name="Detail" Visibility="Collapsed" />
        </Grid>
        </Border>
    </Grid>
</UserControl>
