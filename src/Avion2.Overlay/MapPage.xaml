<UserControl x:Class="Avion2.Overlay.MapPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Avion2.Overlay">
    <Grid Margin="24,16,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Controls -->
        <Border Style="{DynamicResource Card}" Margin="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Map" Style="{DynamicResource CardHeading}" Margin="0,2,0,8" />
                    <ComboBox x:Name="MapBox" DisplayMemberPath="Name" SelectionChanged="MapBox_SelectionChanged" />
                    <CheckBox x:Name="FollowBox" Content="Follow the map I'm on" Margin="0,8,0,0" Click="FollowBox_Click" />

                    <TextBlock Text="Layers" Foreground="{DynamicResource ChipTextBrush}" FontSize="11" Margin="0,16,0,4" />
                    <StackPanel x:Name="LayerList" />

                    <TextBlock Text="Hidden cubes" Foreground="{DynamicResource ChipTextBrush}" FontSize="11" Margin="0,16,0,4" />
                    <TextBlock x:Name="CubeProgress" Foreground="{DynamicResource TitleBrush}" FontFamily="{DynamicResource DisplayFont}" FontSize="16" />
                    <TextBlock x:Name="CubeHint" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Button x:Name="NextCube" Content="Find a cube" Margin="0,8,0,0" HorizontalAlignment="Left" Click="NextCube_Click" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="Skip hides it for" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="SkipBox" DisplayMemberPath="Label" SelectionChanged="SkipBox_SelectionChanged"
                                  ToolTip="Cubes others opened first are gone for a while. A skipped cube also comes back as soon as the game shows it again." />
                    </DockPanel>

                    <TextBlock Text="Find" Foreground="{DynamicResource ChipTextBrush}" FontSize="11" Margin="0,16,0,4" />
                    <Grid>
                        <TextBox x:Name="FindBox" TextChanged="FindBox_TextChanged" />
                        <TextBlock x:Name="FindHint" Text="Monster, NPC, place…" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="11,0,0,0" />
                    </Grid>
                    <ListBox x:Name="FindList" MaxHeight="180" Margin="0,4,0,0" Background="Transparent" BorderThickness="0"
                             SelectionChanged="FindList_SelectionChanged" Visibility="Collapsed">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="8,2" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <TextBlock x:Name="LiveStatus" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Map -->
        <Border Grid.Column="1" CornerRadius="6" ClipToBounds="True" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
            <Grid>
                <local:MapView x:Name="View" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                    <Button x:Name="CenterMe" Content="Center on me" Margin="0,0,6,0" Click="CenterMe_Click" />
                    <Button Content="Whole map" Click="Fit_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
