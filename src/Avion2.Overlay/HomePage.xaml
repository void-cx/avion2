<UserControl x:Class="Avion2.Overlay.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Avion2.Overlay">
    <UserControl.Resources>
        <Style x:Key="CardHead" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="CardCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="Text" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{x:Static local:HomePage.BannerRow}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Banner (the window plays the key-art video behind it) -->
        <Grid Margin="40,0,40,30">
            <Border x:Name="UpdateBanner" Style="{StaticResource FloatingPanel}" Padding="16,12" HorizontalAlignment="Right" VerticalAlignment="Top"
                    MaxWidth="460" Margin="0,18,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TitleBrush}" />
                    <TextBlock x:Name="UpdateDetail" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,10" FontSize="12" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="UpdateNow" Style="{StaticResource AccentButton}" Content="Update now" MinHeight="34" Click="UpdateNow_Click" />
                        <Button Style="{StaticResource QuietButton}" Content="What's new" MinHeight="34" Margin="8,0,0,0" Click="ReleaseNotes_Click" />
                        <Button Style="{StaticResource QuietButton}" Content="Later" MinHeight="34" Margin="8,0,0,0" Click="UpdateLater_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource BrandTitle}" FontSize="54" />
                <TextBlock Text="Passive DPS meter for AION2. Reads network traffic, never touches the game." Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="15" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button x:Name="StartStop" Style="{StaticResource AccentButton}" Content="Start capture" MinWidth="170" MinHeight="42" Click="StartStop_Click" />
                    <Button x:Name="OverlayToggle" Style="{StaticResource QuietButton}" Content="Hide overlay" MinHeight="42" Margin="10,0,0,0" Click="OverlayToggle_Click"
                            Background="{DynamicResource FloatingPanelBrush}" Visibility="Collapsed"
                            ToolTip="Show or hide the DPS overlay (Ctrl+Shift+O). The capture, HUD effects and fight saving keep running either way. When it shows by itself: Settings → Overlays." />
                    <Button Style="{StaticResource QuietButton}" Content="Fight history" MinHeight="42" Margin="10,0,0,0" Click="AllFights_Click"
                            Background="{DynamicResource FloatingPanelBrush}" />
                    <Border Style="{StaticResource FloatingPanel}" CornerRadius="17" Padding="14,0" Height="34" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource IdleBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusTitle" Text="Capture stopped" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="StatusDetail" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="720"
                           Text="Start the meter, then play: the overlay appears and finds the game connection by itself." />
            </StackPanel>
        </Grid>

        <!-- Cards -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="{DynamicResource ContentBrush}">
            <StackPanel Margin="28,22,28,28">
                <TextBlock x:Name="LiveLine" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" Margin="2,0,0,14" Visibility="Collapsed" />

                <UniformGrid Columns="3">
                    <!-- Last fight -->
                    <Border Style="{StaticResource SurfaceCard}" Margin="0,0,8,16" BorderBrush="{DynamicResource FieldBorderBrush}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Style="{StaticResource CardHead}">
                                <TextBlock x:Name="LastWhen" DockPanel.Dock="Right" Style="{StaticResource CardCaption}" />
                                <TextBlock Text="Last fight" Style="{StaticResource CardCaption}" />
                            </DockPanel>
                            <Button x:Name="LastReplay" DockPanel.Dock="Bottom" Style="{StaticResource AccentButton}" Content="Watch replay" MinHeight="36" Margin="0,12,0,0" Click="LastReplay_Click" />
                            <StackPanel>
                                <TextBlock x:Name="LastTitle" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}" TextTrimming="CharacterEllipsis"
                                           Text="No fights yet" />
                                <StackPanel x:Name="LastStats" Orientation="Horizontal" Margin="0,10,0,0">
                                    <StackPanel Margin="0,0,24,0"><TextBlock Text="Your DPS" Style="{StaticResource StatLabel}" />
                                        <TextBlock x:Name="LastDps" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Duration" Style="{StaticResource StatLabel}" />
                                        <TextBlock x:Name="LastDuration" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}" /></StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="NoFights" Text="Fights show up here when they end." Style="{StaticResource CardCaption}" Margin="0,8,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Up next -->
                    <Border Style="{StaticResource SurfaceCard}" Margin="8,0,8,16">
                        <StackPanel>
                            <DockPanel Style="{StaticResource CardHead}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="All timers" Click="Timers_Click" />
                                <TextBlock Text="Up next" Style="{StaticResource CardCaption}" />
                            </DockPanel>
                            <ItemsControl x:Name="ComingUp">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="34" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" ToolTip="{Binding Category}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding In}" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Character -->
                    <Border Style="{StaticResource SurfaceCard}" Margin="8,0,0,16">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Style="{StaticResource CardHead}">
                                <TextBlock x:Name="InventoryAge" DockPanel.Dock="Right" Style="{StaticResource CardCaption}" />
                                <TextBlock Text="Character" Style="{StaticResource CardCaption}" />
                            </DockPanel>
                            <Button DockPanel.Dock="Bottom" Style="{StaticResource QuietButton}" Content="Open Gear Forge" MinHeight="36" Margin="0,12,0,0" Click="Forge_Click" />
                            <StackPanel>
                                <TextBlock x:Name="CharactersValue" Foreground="{DynamicResource TitleBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <StackPanel x:Name="Wallet" Orientation="Horizontal" Margin="0,10,0,0">
                                    <StackPanel Margin="0,0,24,0"><TextBlock Text="Kinah" Style="{StaticResource StatLabel}" />
                                        <TextBlock x:Name="KinahValue" Style="{StaticResource StatValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Enhance Stones" Style="{StaticResource StatLabel}" />
                                        <TextBlock x:Name="StonesValue" Style="{StaticResource StatValue}" /></StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </UniformGrid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Recent fights -->
                    <Border Style="{StaticResource SurfaceCard}" Margin="0,0,8,16" Padding="16,14,16,8">
                        <StackPanel>
                            <DockPanel Style="{StaticResource CardHead}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="All fights" Click="AllFights_Click" />
                                <TextBlock Text="Recent fights" Style="{StaticResource CardCaption}" />
                            </DockPanel>
                            <ItemsControl x:Name="Recent">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="36" Cursor="Hand" MouseLeftButtonUp="Recent_Click" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}">
                                                    <Run Text="{Binding Day, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0">
                                                    <Run Text="{Binding Boss, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" /> <Run Text="{Binding Extra, Mode=OneWay}" Foreground="{DynamicResource SectionLabelBrush}" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Text="{Binding Duration}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextAlignment="Right" />
                                                <TextBlock Grid.Column="3" Text="{Binding YourDpsFull}" Foreground="{DynamicResource TitleBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Capture setup -->
                    <Border Grid.Column="1" Style="{StaticResource SurfaceCard}" Margin="8,0,0,16">
                        <StackPanel x:Name="Options">
                            <TextBlock Text="Capture" Style="{StaticResource CardCaption}" Margin="0,0,0,10" />
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock x:Name="NpcapValue" DockPanel.Dock="Right" Foreground="{DynamicResource TitleBrush}" />
                                <TextBlock Text="Npcap" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock x:Name="NamesValue" DockPanel.Dock="Right" Foreground="{DynamicResource TitleBrush}" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
                                <TextBlock Text="Names" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </DockPanel>
                            <ComboBox x:Name="DeviceBox" DisplayMemberPath="Label" Margin="0,0,0,10"
                                      ToolTip="Automatic captures on every adapter and finds the game connection by itself (also through VPNs and ping reducers)." />
                            <CheckBox x:Name="RecordBox" Content="Record session (.pcap)" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Legion -->
                <Border x:Name="LegionCard" Style="{StaticResource SurfaceCard}" Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel Style="{StaticResource CardHead}">
                            <TextBlock x:Name="LegionMeta" DockPanel.Dock="Right" Style="{StaticResource CardCaption}" />
                            <TextBlock x:Name="LegionName" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}" />
                        </DockPanel>
                        <TextBlock x:Name="LegionIntro" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10" MaxHeight="54"
                                   TextTrimming="CharacterEllipsis" />
                        <ItemsControl x:Name="LegionMembers">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,18,5">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Seen}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TitleBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
