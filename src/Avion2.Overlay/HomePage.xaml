<UserControl x:Class="Avion2.Overlay.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ChipTextBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">
            <!-- Update available -->
            <Border x:Name="UpdateBanner" Style="{DynamicResource Card}" MaxWidth="984" Margin="8,0,8,8" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="What's new" Margin="0,0,8,0" Click="ReleaseNotes_Click" />
                        <Button Content="Later" Margin="0,0,8,0" Click="UpdateLater_Click" />
                        <Button x:Name="UpdateNow" Content="Update now" Style="{DynamicResource PrimaryButton}" Click="UpdateNow_Click" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateTitle" Style="{DynamicResource CardHeading}" FontSize="16" />
                        <TextBlock x:Name="UpdateDetail" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,12,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Hero -->
            <TextBlock Style="{DynamicResource HeroEyebrow}" Margin="0,24,0,6" />
            <TextBlock Style="{DynamicResource HeroTitle}" />
            <Rectangle Height="1" Width="620" Margin="0,8,0,0" Fill="{DynamicResource DividerBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource IdleBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusTitle" Text="Meter stopped" FontFamily="{DynamicResource DisplayFont}" FontSize="16"
                           Foreground="{DynamicResource TitleBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="StatusDetail" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="720"
                       Text="Start the meter, then play: the overlay appears and finds the game connection by itself." />
            <TextBlock x:Name="LiveLine" HorizontalAlignment="Center" Margin="0,6,0,0" FontWeight="SemiBold"
                       Foreground="{DynamicResource HighlightBrush}" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                <Button x:Name="StartStop" Style="{DynamicResource PrimaryButton}" Content="Start Meter" MinWidth="230" Margin="0,0,14,0" Click="StartStop_Click" />
                <Button Style="{DynamicResource SecondaryButton}" Content="Fight History" MinWidth="230" Click="AllFights_Click" />
            </StackPanel>

            <WrapPanel x:Name="Options" HorizontalAlignment="Center" Margin="0,16,0,0">
                <TextBlock Text="Capture" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                <ComboBox x:Name="DeviceBox" Width="320" Margin="0,0,16,0" DisplayMemberPath="Label"
                          ToolTip="Automatic captures on every adapter and finds the game connection by itself (also through VPNs and ping reducers)." />
                <CheckBox x:Name="RecordBox" Content="Record session (.pcap)" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
            </WrapPanel>

            <!-- Status cards (site "Notice / Event" cards) -->
            <UniformGrid Columns="3" Margin="0,44,0,0" MaxWidth="1000">
                <Grid Margin="8,0">
                    <Border Style="{DynamicResource Card}" Margin="0,8,0,0" MinHeight="96">
                        <StackPanel>
                            <Border Style="{DynamicResource Chip}"><TextBlock Text="Capture" Style="{StaticResource CardLabel}" /></Border>
                            <TextBlock x:Name="NpcapValue" Style="{StaticResource CardValue}" />
                        </StackPanel>
                    </Border>
                    <Path Style="{DynamicResource Ornament}" VerticalAlignment="Top" HorizontalAlignment="Center" />
                </Grid>
                <Grid Margin="8,0">
                    <Border Style="{DynamicResource Card}" Margin="0,8,0,0" MinHeight="96">
                        <StackPanel>
                            <Border Style="{DynamicResource Chip}"><TextBlock Text="Names" Style="{StaticResource CardLabel}" /></Border>
                            <TextBlock x:Name="NamesValue" Style="{StaticResource CardValue}" />
                        </StackPanel>
                    </Border>
                    <Path Style="{DynamicResource Ornament}" VerticalAlignment="Top" HorizontalAlignment="Center" />
                </Grid>
                <Grid Margin="8,0">
                    <Border Style="{DynamicResource Card}" Margin="0,8,0,0" MinHeight="96">
                        <StackPanel>
                            <Border Style="{DynamicResource Chip}"><TextBlock Text="Daeva" Style="{StaticResource CardLabel}" /></Border>
                            <TextBlock x:Name="CharactersValue" Style="{StaticResource CardValue}" />
                        </StackPanel>
                    </Border>
                    <Path Style="{DynamicResource Ornament}" VerticalAlignment="Top" HorizontalAlignment="Center" />
                </Grid>
            </UniformGrid>

            <!-- Coming up (details on the Timers page) -->
            <Grid Margin="8,30,8,0" MaxWidth="984">
                <Border Style="{DynamicResource Card}" Margin="0,8,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,4,0,10">
                            <Button DockPanel.Dock="Right" Content="All timers →" Click="Timers_Click" />
                            <TextBlock Text="Coming Up" Style="{DynamicResource CardHeading}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl x:Name="ComingUp">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,18,4">
                                        <TextBlock Text="{Binding Category}" Foreground="{DynamicResource ChipTextBrush}" FontSize="11" />
                                        <TextBlock Text="{Binding In}" FontFamily="{DynamicResource DisplayFont}" FontSize="22" Foreground="{DynamicResource TitleBrush}" Margin="0,2,0,0" />
                                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" · " Foreground="{DynamicResource MutedBrush}" /><Run Text="{Binding At, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Path Style="{DynamicResource Ornament}" VerticalAlignment="Top" HorizontalAlignment="Center" />
            </Grid>

            <!-- Legion -->
            <Grid x:Name="LegionCard" Margin="8,30,8,0" MaxWidth="984" Visibility="Collapsed">
                <Border Style="{DynamicResource Card}" Margin="0,8,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,4,0,6">
                            <TextBlock x:Name="LegionMeta" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock x:Name="LegionName" Style="{DynamicResource CardHeading}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock x:Name="LegionIntro" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10" MaxHeight="54"
                                   TextTrimming="CharacterEllipsis" />
                        <ItemsControl x:Name="LegionMembers">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,18,5">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Seen}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TitleBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Path Style="{DynamicResource Ornament}" VerticalAlignment="Top" HorizontalAlignment="Center" />
            </Grid>

            <!-- Recent fights -->
            <Grid Margin="8,30,8,0" MaxWidth="984">
                <Border Style="{DynamicResource Card}" Margin="0,8,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,4,0,10">
                            <Button DockPanel.Dock="Right" Content="All fights →" Click="AllFights_Click" />
                            <TextBlock Text="Recent Fights" Style="{DynamicResource CardHeading}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock x:Name="NoFights" Text="No fights yet. They show up here when they end." Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed" Margin="0,0,0,6" />
                        <ItemsControl x:Name="Recent">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" Cursor="Hand" MouseLeftButtonUp="Recent_Click" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding When}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource TitleBrush}" FontFamily="{DynamicResource DisplayFont}" FontSize="14"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Duration}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center">
                                                <Run Text="You " Foreground="{DynamicResource MutedBrush}" /><Run Text="{Binding YourDps, Mode=OneWay}" Foreground="{DynamicResource SelfBrush}" /><Run Text="/s" Foreground="{DynamicResource MutedBrush}" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="4" VerticalAlignment="Center">
                                                <Run Text="Party " Foreground="{DynamicResource MutedBrush}" /><Run Text="{Binding TotalDps, Mode=OneWay}" Foreground="{DynamicResource HighlightBrush}" /><Run Text="/s" Foreground="{DynamicResource MutedBrush}" />
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Path Style="{DynamicResource Ornament}" VerticalAlignment="Top" HorizontalAlignment="Center" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
