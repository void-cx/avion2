<Window x:Class="Avion2.Overlay.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Avion2.Overlay"
        Title="AVION2 · Fight"
        ThemeMode="Dark"
        Width="1280" Height="800" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ContentBrush}"
        FontFamily="{DynamicResource BodyFont}" FontSize="13">
    <local:DetailView x:Name="View" />
</Window>
