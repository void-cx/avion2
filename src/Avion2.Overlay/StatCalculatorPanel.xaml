<UserControl x:Class="Avion2.Overlay.StatCalculatorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="HeaderCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- One attribute: its name, the points, what they give and what the change from the character gives -->
        <DataTemplate x:Key="InputCell">
            <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,7,0,6" Margin="0,0,14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="66" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tip}">
                        <Run Text="{Binding Name, Mode=OneWay}" Foreground="{DynamicResource TitleBrush}" FontFamily="{DynamicResource DisplayFont}" />
                        <Run Text="{Binding Lord, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                    </TextBlock>
                    <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" MaxLength="5" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Effect}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Change}" Visibility="{Binding ChangeVisibility}"
                               Foreground="{DynamicResource HighlightBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="20,0,28,24" MaxWidth="1240" HorizontalAlignment="Left">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="480" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- The values -->
        <Border Style="{StaticResource SurfaceCard}" Margin="8,8,8,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,6">
                        <Button x:Name="FillButton" Style="{StaticResource AccentButton}" MinHeight="34" Padding="14,0" Margin="0,0,8,6" Click="Fill_Click" />
                        <Button x:Name="ClearButton" Style="{StaticResource QuietButton}" MinHeight="34" Content="Clear" Margin="0,0,0,6" Click="Clear_Click"
                                ToolTip="Set every value to 0 and forget the character's" />
                    </WrapPanel>
                    <TextBlock x:Name="FillNote" Style="{StaticResource Note}" Margin="0,0,0,12" />

                    <TextBlock Text="ATTRIBUTES" Style="{StaticResource SectionLabel}" Margin="0,0,0,2" />
                    <TextBlock Style="{StaticResource Note}" Margin="0,0,0,6" Text="The six stats in the middle of the character's stat wheel." />
                    <ItemsControl x:Name="PrimaryList" ItemTemplate="{StaticResource InputCell}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Text="DEITY STATS" Style="{StaticResource SectionLabel}" Margin="0,16,0,2" />
                    <TextBlock Style="{StaticResource Note}" Margin="0,0,0,6"
                               Text="The ten Empyrean Lords of the outer ring: from monoliths, bracelets and arcana. Light [Ariel] and Darkness [Azphel] convert into nothing in the game data." />
                    <ItemsControl x:Name="DeityList" ItemTemplate="{StaticResource InputCell}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- What they give -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8,8,8,0">
                <Border Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <TextBlock Text="WHAT THEY GIVE" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                        <TextBlock x:Name="ResultIntro" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <Grid x:Name="ResultHeader" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Stat" Style="{StaticResource HeaderCell}" TextAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="Total" Style="{StaticResource HeaderCell}" />
                            <TextBlock x:Name="VersusHeader" Grid.Column="2" Style="{StaticResource HeaderCell}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <ItemsControl x:Name="ResultList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="{Binding Line}" Padding="0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="96" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" FontSize="{Binding NameSize}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource TitleBrush}" FontFamily="{DynamicResource DisplayFont}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="{Binding Difference}" Foreground="{Binding DifferenceBrush}" TextAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Note}" Margin="0,12,0,0"
                                   Text="This computes the attribute conversions only: each point gives a fixed share of its stats (no diminishing returns), added up over every attribute that gives the same stat. The stat sheet in game also adds flat stats from class, level, gear, manastones, skills and buffs, so its totals are higher." />
                        <TextBlock x:Name="SourceNote" Style="{StaticResource Note}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
