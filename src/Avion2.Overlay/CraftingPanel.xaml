<UserControl x:Class="Avion2.Overlay.CraftingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="HeaderCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,0,28,24" MaxWidth="1240" HorizontalAlignment="Left">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Recipe search -->
        <Border Style="{StaticResource SurfaceCard}" Margin="8,8,8,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton x:Name="LightSide" Style="{StaticResource Segment}" Content="Elyos" GroupName="CraftSide" IsChecked="True" Checked="Side_Checked" />
                    <RadioButton x:Name="DarkSide" Style="{StaticResource Segment}" Content="Asmodian" GroupName="CraftSide" Checked="Side_Checked" />
                </StackPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ProfessionBox" SelectionChanged="Browse_Changed" ToolTip="Recipes of one profession" />
                    <ComboBox x:Name="CategoryBox" Grid.Column="2" SelectionChanged="Browse_Changed" ToolTip="Recipes of one item type" />
                </Grid>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" />
                    <TextBlock x:Name="SearchHint" Text="Search: item, profession or type, e.g. alchemy orb" IsHitTestVisible="False"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="11,0,0,0" />
                </Grid>
                <TextBlock x:Name="ResultCount" DockPanel.Dock="Top" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,6" />
                <ListBox x:Name="ProductList" SelectionChanged="ProductList_SelectionChanged" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="10,4" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Name}" Foreground="{Binding Brush}" FontFamily="{DynamicResource DisplayFont}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Plan -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8,8,8,0">
                <Border x:Name="PlanCard" Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <TextBlock x:Name="ProductName" Style="{StaticResource PaneTitle}" FontSize="20" Text="Pick an item" />
                        <TextBlock x:Name="ProductMeta" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Text="Search a craftable item on the left: the calculator lists every material down to the gathered ones, and what your bag already holds." />
                        <TextBlock x:Name="ComboText" Foreground="{DynamicResource HighlightBrush}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                   ToolTip="A combo is a second race after the craft succeeds: won, it makes this item instead (the plan doesn't count on it)." />
                        <TextBlock x:Name="BagLine" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <StackPanel x:Name="Controls" Orientation="Horizontal" Margin="0,14,0,0" IsEnabled="False">
                            <TextBlock Text="Make" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBox x:Name="QuantityBox" Width="70" Text="1" TextChanged="QuantityBox_TextChanged" />
                            <TextBlock x:Name="QuantityNote" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="Results" Visibility="Collapsed">
                    <TextBlock x:Name="Summary" Foreground="{DynamicResource TitleBrush}" FontFamily="{DynamicResource DisplayFont}" FontSize="15"
                               Margin="4,18,0,4" TextWrapping="Wrap" />
                    <TextBlock x:Name="KinahLine" Foreground="{DynamicResource SecondaryTextBrush}" Margin="4,0,0,12" TextWrapping="Wrap" />

                    <Border Style="{StaticResource SurfaceCard}" Margin="0,0,10,12">
                        <StackPanel>
                            <TextBlock Text="BASE MATERIALS" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Item" Style="{StaticResource HeaderCell}" TextAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="Needed" Style="{StaticResource HeaderCell}" />
                                <TextBlock Grid.Column="2" Text="In your bag" Style="{StaticResource HeaderCell}" />
                                <TextBlock Grid.Column="3" Text="Missing" Style="{StaticResource HeaderCell}" />
                            </Grid>
                            <ItemsControl x:Name="MaterialList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Foreground="{Binding Brush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Need}" Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Right" />
                                                <TextBlock Grid.Column="2" Text="{Binding Have}" Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Right" />
                                                <TextBlock Grid.Column="3" Text="{Binding Missing}" Foreground="{Binding MissingBrush}" TextAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SurfaceCard}" Margin="0,0,10,12">
                        <StackPanel>
                            <TextBlock Text="CRAFTING STEPS" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
                            <ItemsControl x:Name="StepList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,5">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Right" Content="buy / gather" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center"
                                                          IsChecked="{Binding Bought, Mode=OneWay}" Visibility="{Binding BuyVisibility}" Tag="{Binding ItemId}" Click="Buy_Click"
                                                          ToolTip="Buy or gather this instead of crafting it: it then counts as a base material (remembered for this item)" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding How}" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0" />
                                                <StackPanel Margin="{Binding Indent}">
                                                    <TextBlock TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Need, Mode=OneWay}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        <Run Text="{Binding Name, Mode=OneWay}" Foreground="{Binding Brush, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Combo}" Visibility="{Binding ComboVisibility}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0"
                                       Text="Recipes from the game data as of September 2026: the True Dragon and Star Dragon recipes of the November 4 patch (always succeed, no combo, bound result) are not in it yet. What your bag holds counts first, intermediate items too, and a bound material counts for its tradable one (the game takes either). A combo (a second race after the first succeeds) can make the better item instead; the plan doesn't count on it. Tick buy / gather on a material you'd rather buy or gather than craft: it then counts as a base material." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border x:Name="LogCard" Style="{StaticResource SurfaceCard}" Margin="0,18,10,0" Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock x:Name="LogWho" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                            <TextBlock Text="YOUR CRAFTS" Style="{StaticResource SectionLabel}" />
                        </DockPanel>
                        <ItemsControl x:Name="LogList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding When}" Foreground="{DynamicResource MutedBrush}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Made}" Foreground="{DynamicResource TitleBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Used}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0"
                                   Text="Crafts the meter saw: what left your bag when each started and what arrived when it ended." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
