<Window x:Class="Avion2.Overlay.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AVION2 Notifications"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="380" Height="260" FontFamily="{DynamicResource BodyFont}" FontSize="12">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid>
        <!-- Placeholder while positioning: drag to move -->
        <Border x:Name="Placeholder" Visibility="Collapsed" CornerRadius="6" Background="{DynamicResource PlaceholderBackground}"
                MouseLeftButtonDown="Placeholder_MouseLeftButtonDown" Cursor="SizeAll">
            <Border.BorderBrush>
                <DrawingBrush Viewport="0,0,12,12" ViewportUnits="Absolute" TileMode="Tile">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="{DynamicResource PlaceholderStripeBrush}">
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <RectangleGeometry Rect="0,0,6,6" />
                                        <RectangleGeometry Rect="6,6,6,6" />
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>2</Border.BorderThickness>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path Style="{DynamicResource Ornament}" Margin="0,0,0,8" />
                <TextBlock Text="Notification area" FontFamily="{DynamicResource DisplayFont}" FontSize="16" Foreground="{DynamicResource TitleBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Drag to move · notices stack from the top" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,10" />
                <Button Content="Done" Style="{DynamicResource PrimaryButton}" MinWidth="140" HorizontalAlignment="Center" Click="Done_Click" />
            </StackPanel>
        </Border>

        <!-- Notices -->
        <ItemsControl x:Name="Notices" VerticalAlignment="Top">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10,4,10,4" Opacity="{Binding Opacity}">
                        <Border Margin="0,8,0,0" CornerRadius="{DynamicResource OverlayCornerRadius}" BorderBrush="{DynamicResource NoticeBorderBrush}" BorderThickness="1"
                                Background="{DynamicResource NoticeBackground}" Effect="{DynamicResource NoticeGlow}" />
                        <Border Margin="0,8,0,0" Padding="16,10,16,10">
                            <StackPanel>
                                <Border Style="{DynamicResource Chip}">
                                    <TextBlock Text="{Binding Chip}" Foreground="{DynamicResource NoticeChipBrush}" FontSize="10.5" />
                                </Border>
                                <TextBlock Text="{Binding Text}" Margin="0,5,0,0" FontFamily="{DynamicResource DisplayFont}" FontSize="15"
                                           Foreground="{DynamicResource TitleBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Path Style="{DynamicResource Ornament}" Width="13" Height="13" VerticalAlignment="Top" HorizontalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
