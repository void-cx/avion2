<Window x:Class="Avion2.Overlay.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AVION2 Notifications"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="380" Height="260" FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid>
        <!-- Placeholder while positioning: drag to move -->
        <Border x:Name="Placeholder" Visibility="Collapsed" CornerRadius="6" Background="#99050A13"
                MouseLeftButtonDown="Placeholder_MouseLeftButtonDown" Cursor="SizeAll">
            <Border.BorderBrush>
                <DrawingBrush Viewport="0,0,12,12" ViewportUnits="Absolute" TileMode="Tile">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="#CC7FD8FF">
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <RectangleGeometry Rect="0,0,6,6" />
                                        <RectangleGeometry Rect="6,6,6,6" />
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>2</Border.BorderThickness>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path Style="{StaticResource AionStar}" Margin="0,0,0,8" />
                <TextBlock Text="Notification area" FontFamily="{StaticResource AionDisplayFont}" FontSize="16" Foreground="White"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Drag to move · notices stack from the top" Foreground="#C9D7E4" HorizontalAlignment="Center" Margin="0,4,0,10" />
                <Button Content="Done" Style="{StaticResource AionPrimaryButton}" MinWidth="140" HorizontalAlignment="Center" Click="Done_Click" />
            </StackPanel>
        </Border>

        <!-- Notices -->
        <ItemsControl x:Name="Notices" VerticalAlignment="Top">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10,4,10,4" Opacity="{Binding Opacity}">
                        <Border Margin="0,8,0,0" Padding="16,10,16,10" CornerRadius="3" BorderBrush="#E6D9C08A" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#E6261F10" Offset="0" />
                                    <GradientStop Color="#F00A1626" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#D9C08A" BlurRadius="18" ShadowDepth="0" Opacity="0.45" />
                            </Border.Effect>
                            <StackPanel>
                                <Border Style="{StaticResource AionChip}">
                                    <TextBlock Text="{Binding Chip}" Foreground="#D9C08A" FontSize="10.5" />
                                </Border>
                                <TextBlock Text="{Binding Text}" Margin="0,5,0,0" FontFamily="{StaticResource AionDisplayFont}" FontSize="15"
                                           Foreground="White" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Path Style="{StaticResource AionStar}" Width="13" Height="13" VerticalAlignment="Top" HorizontalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
