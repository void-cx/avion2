<Window x:Class="Avion2.Overlay.HudCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Avion2.Overlay"
        Title="AVION2 · HUD calibration"
        ThemeMode="Dark"
        Width="1280" Height="820" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ContentBrush}"
        FontFamily="{DynamicResource BodyFont}" FontSize="13">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="22,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource QuietButton}" Content="Find again" Click="Detect_Click" Margin="0,0,8,0"
                            ToolTip="Look for the HUD elements in the picture again (moves the markers)" />
                    <Button Style="{StaticResource QuietButton}" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" />
                    <Button Style="{StaticResource AccentButton}" Content="Save" Width="120" Click="Save_Click" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Where is your HUD?" Style="{StaticResource PageTitle}" FontSize="22" />
                    <TextBlock x:Name="Summary" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,10">
            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                       Text="Drag a box to move it, drag its corner to resize it. The picture is only used here and is not saved; AVION2 keeps the box positions for this game resolution." />
        </Border>
        <Viewbox Stretch="Uniform" Margin="16">
            <Grid x:Name="Picture">
                <Image x:Name="Shot" Stretch="None" />
                <Canvas x:Name="Markers" />
            </Grid>
        </Viewbox>
    </DockPanel>
</Window>
