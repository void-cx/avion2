<UserControl x:Class="Avion2.Overlay.ForgePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Avion2.Overlay">
    <UserControl.Resources>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ChipTextBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="TileNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="HeaderCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="28,26,28,10">
        <TextBlock Text="Gear Forge" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="Subtitle" Text="Expected attempts, materials and Kinah to enchant or amplify an item, from the game's own tables." Style="{StaticResource PageSubtitle}" />
        <!-- The Forge's tools: one tab each, with an icon; a new calculator adds a tab here and a panel below -->
        <WrapPanel x:Name="ToolTabs" Margin="0,8,0,0">
            <WrapPanel.Resources>
                <Geometry x:Key="IconEnchant">M12,3 L13.8,10.2 L21,12 L13.8,13.8 L12,21 L10.2,13.8 L3,12 L10.2,10.2 Z</Geometry>
                <Geometry x:Key="IconCrafting">M9,3 H15 M10,3 V9 L5,19 C4.6,20 5.3,21 6.3,21 H17.7 C18.7,21 19.4,20 19,19 L14,9 V3 M7.5,15 H16.5</Geometry>
                <Geometry x:Key="IconStats">M4,20 H20 M7,20 V12 M12,20 V5 M17,20 V15</Geometry>
                <Style x:Key="ToolTab" TargetType="RadioButton" BasedOn="{StaticResource TabLink}">
                    <Setter Property="GroupName" Value="ForgeTool" />
                    <Setter Property="Height" Value="34" />
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Path Style="{StaticResource IconPath}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              Data="{Binding (local:Ui.Icon), RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    </Viewbox>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </WrapPanel.Resources>
            <RadioButton x:Name="ForgeTabLink" Style="{StaticResource ToolTab}" Content="Enchant and amplify" Tag="enchant" IsChecked="True" Checked="ForgeTab_Checked"
                         local:Ui.Icon="{StaticResource IconEnchant}" />
            <RadioButton x:Name="CraftingTabLink" Style="{StaticResource ToolTab}" Content="Crafting" Tag="crafting" Checked="ForgeTab_Checked"
                         local:Ui.Icon="{StaticResource IconCrafting}" />
            <RadioButton x:Name="StatsTabLink" Style="{StaticResource ToolTab}" Content="Stats" Tag="stats" Checked="ForgeTab_Checked"
                         local:Ui.Icon="{StaticResource IconStats}" />
        </WrapPanel>
    </StackPanel>
    <Grid>
    <local:CraftingPanel x:Name="Crafting" Visibility="Collapsed" />
    <local:StatCalculatorPanel x:Name="Stats" Visibility="Collapsed" />
    <Grid x:Name="ForgeGrid" Margin="20,0,28,24" MaxWidth="1240" HorizontalAlignment="Left">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Item search -->
        <Border Style="{StaticResource SurfaceCard}" Margin="8,8,8,0">
            <DockPanel>
                <StackPanel x:Name="MyGearPanel" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,10">
                    <TextBlock x:Name="MyGearTitle" Foreground="{DynamicResource ChipTextBrush}" FontSize="11" Margin="0,0,0,4" />
                    <ListBox x:Name="MyGear" MaxHeight="230" Background="Transparent" BorderThickness="0" SelectionChanged="MyGear_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="10,2" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="20" Height="20" Margin="0,1,8,1" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Level}" Foreground="{DynamicResource HighlightBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" Foreground="{Binding Brush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="All items" Foreground="{DynamicResource ChipTextBrush}" FontSize="11" Margin="0,10,0,0" />
                </StackPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" />
                    <TextBlock x:Name="SearchHint" Text="Search: item name or type, e.g. unique bow" IsHitTestVisible="False"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="11,0,0,0" />
                </Grid>
                <TextBlock x:Name="ResultCount" DockPanel.Dock="Top" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,6" />
                <ListBox x:Name="ItemList" SelectionChanged="ItemList_SelectionChanged" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="10,4" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="{Binding Brush}" FontFamily="{DynamicResource DisplayFont}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Plan -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8,8,8,0">
                <!-- Best next upgrades of the equipped gear -->
                <Border x:Name="UpgradesCard" Style="{StaticResource SurfaceCard}" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="BEST NEXT UPGRADES" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                        <TextBlock x:Name="UpgradesIntro" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <ListBox x:Name="UpgradeList" Background="Transparent" BorderThickness="0" SelectionChanged="UpgradeList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="8,5" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Detail}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <DockPanel>
                                            <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="{Binding Brush}" FontFamily="{DynamicResource DisplayFont}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Gain}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Step}" Foreground="{DynamicResource TitleBrush}" FontFamily="{DynamicResource DisplayFont}" TextAlignment="Right" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Kinah}" Foreground="{DynamicResource HighlightBrush}" TextAlignment="Right" />
                                            <TextBlock Text="{Binding Chance}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextAlignment="Right" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Materials}" Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Afford}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button x:Name="UpgradesMore" HorizontalAlignment="Left" Margin="0,8,0,0" Click="UpgradesMore_Click" Visibility="Collapsed" />
                        <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="Each enchant step adds 1 item level (from the game data; for +11 and up some players count 2). Sorted by average Kinah per item level. Combat power isn't shown: how the game computes it isn't known. Click an item for its full plan." />
                    </StackPanel>
                </Border>

                <Border x:Name="PlanCard" Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <DockPanel>
                            <Image x:Name="ItemIcon" DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center"
                                   Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock x:Name="ItemName" Style="{StaticResource PaneTitle}" FontSize="20" Text="Pick an item" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock x:Name="ItemMeta" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"
                                   Text="Search your gear on the left: the Forge loads its enchant and amplify ladders from the game data." TextWrapping="Wrap" />
                        <TextBlock x:Name="HaveLine" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

                        <WrapPanel x:Name="Controls" Margin="0,14,0,0" IsEnabled="False">
                            <RadioButton x:Name="EnchantMode" Content="Enchant" GroupName="Mode" IsChecked="True" Checked="Mode_Checked" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <RadioButton x:Name="AmplifyMode" Content="Amplify" GroupName="Mode" Checked="Mode_Checked" Margin="0,0,28,0" VerticalAlignment="Center" />
                            <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <ComboBox x:Name="FromBox" Width="80" SelectionChanged="Level_Changed" Margin="0,0,16,0" />
                            <TextBlock Text="to" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <ComboBox x:Name="ToBox" Width="80" SelectionChanged="Level_Changed" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="Results" Visibility="Collapsed">
                    <TextBlock x:Name="Summary" Foreground="{DynamicResource SecondaryTextBrush}" Margin="4,18,0,8" TextWrapping="Wrap" />
                    <ItemsControl x:Name="Tiles">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SurfaceCard}" Margin="0,0,10,10">
                                    <Grid>
                                        <!-- The material's icon in the corner; tiles without one keep their layout -->
                                        <Image Source="{Binding Icon}" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource TileLabel}" TextTrimming="CharacterEllipsis" Margin="0,0,36,0" />
                                            <TextBlock Text="{Binding Average}" Style="{StaticResource TileValue}" />
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource TileNote}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="ReachLine" Foreground="{DynamicResource TitleBrush}" FontFamily="{DynamicResource DisplayFont}" FontSize="15"
                               Margin="4,0,0,12" TextWrapping="Wrap" Visibility="Collapsed" />
                    <Border Style="{StaticResource SurfaceCard}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="PER LEVEL" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Step" Style="{StaticResource HeaderCell}" TextAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="Chance" Style="{StaticResource HeaderCell}" />
                                <TextBlock Grid.Column="2" Text="Pity / fail" Style="{StaticResource HeaderCell}" />
                                <TextBlock Grid.Column="3" Text="Avg attempts" Style="{StaticResource HeaderCell}" />
                                <TextBlock Grid.Column="4" Text="Avg materials" Style="{StaticResource HeaderCell}" />
                                <TextBlock Grid.Column="5" Text="Avg Kinah" Style="{StaticResource HeaderCell}" />
                            </Grid>
                            <ItemsControl x:Name="StepList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,5">
                                            <Grid ToolTip="{Binding Detail}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Step}" Foreground="{DynamicResource TitleBrush}" FontFamily="{DynamicResource DisplayFont}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Chance}" Foreground="{DynamicResource HighlightBrush}" TextAlignment="Right" />
                                                <TextBlock Grid.Column="2" Text="{Binding Pity}" Foreground="{DynamicResource MutedBrush}" TextAlignment="Right" />
                                                <TextBlock Grid.Column="3" Text="{Binding Attempts}" Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Right" />
                                                <TextBlock Grid.Column="4" Text="{Binding Materials}" Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Right" />
                                                <TextBlock Grid.Column="5" Text="{Binding Gold}" Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="Rates and costs are datamined from the game. A failed attempt keeps the level and raises the next attempt's chance by the pity value until it succeeds. Unlucky = 90th percentile of 20,000 simulated runs." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </Grid>
    </DockPanel>
</UserControl>
