<Window x:Class="Avion2.Overlay.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AVION2 HUD"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        FontFamily="{DynamicResource BodyFont}">
    <!-- Effects drawn over the game's own HUD; click-through, positioned over the game's client area -->
    <Canvas x:Name="Stage" IsHitTestVisible="False">
        <!-- Big hit: red light along the screen edges -->
        <Grid x:Name="EdgeFlash" Opacity="0" Visibility="Collapsed">
            <Rectangle Height="120" VerticalAlignment="Top">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#B0FF1E1E" Offset="0" />
                        <GradientStop Color="#00FF1E1E" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Height="120" VerticalAlignment="Bottom">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#B0FF1E1E" Offset="0" />
                        <GradientStop Color="#00FF1E1E" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Width="140" HorizontalAlignment="Left">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#B0FF1E1E" Offset="0" />
                        <GradientStop Color="#00FF1E1E" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Width="140" HorizontalAlignment="Right">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                        <GradientStop Color="#B0FF1E1E" Offset="0" />
                        <GradientStop Color="#00FF1E1E" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Your DPS in the current fight, just above your HP bar -->
        <Border x:Name="DpsLine" Padding="8,2" CornerRadius="3" Background="#A6070D18" Visibility="Collapsed">
            <TextBlock x:Name="DpsText" Foreground="White" FontSize="13">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="0" Opacity="0.9" />
                </TextBlock.Effect>
            </TextBlock>
        </Border>

        <!-- Boss: exact HP, share left, time to kill, fight clock (under the boss bar, right) -->
        <TextBlock x:Name="BossInfo" Foreground="White" FontSize="13" Visibility="Collapsed">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="0" Opacity="1" />
            </TextBlock.Effect>
        </TextBlock>

        <!-- What hit you (with the red edge flash), above your HP bar on the left -->
        <TextBlock x:Name="HitInfo" Foreground="#FFFF8A80" FontSize="15" FontWeight="SemiBold" Visibility="Collapsed" Opacity="0">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="0" Opacity="1" />
            </TextBlock.Effect>
        </TextBlock>

        <!-- Party DPS, styled like the game's group list, right under it -->
        <StackPanel x:Name="PartyMeter" Visibility="Collapsed">
            <StackPanel.Effect>
                <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="0" Opacity="0.95" />
            </StackPanel.Effect>
        </StackPanel>

        <!-- Low HP: a pulsing red frame around your HP bar -->
        <Border x:Name="HpGlow" BorderBrush="#FFFF3B3B" BorderThickness="2.5" CornerRadius="4" Visibility="Collapsed" Opacity="0">
            <Border.Background>
                <SolidColorBrush Color="#33FF2A2A" />
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#FF2A2A" BlurRadius="22" ShadowDepth="0" Opacity="1" />
            </Border.Effect>
        </Border>

        <!-- Boss skill under the target frame -->
        <Border x:Name="CastBanner" Padding="14,6" CornerRadius="4" Visibility="Collapsed" Opacity="0"
                Background="#E6140A0C" BorderBrush="#FFE5484D" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="CastBoss" Foreground="#FFFF9A90" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="CastSkill" Foreground="White" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
