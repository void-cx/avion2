<Window x:Class="Avion2.Overlay.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AVION2 HUD"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        FontFamily="{DynamicResource BodyFont}">
    <!-- Effects drawn over the game's own HUD; click-through, positioned over the game's client area -->
    <Canvas x:Name="Stage" IsHitTestVisible="False">
        <!-- Low HP: a pulsing red frame around your HP bar -->
        <Border x:Name="HpGlow" BorderBrush="#FFFF3B3B" BorderThickness="2.5" CornerRadius="4" Visibility="Collapsed" Opacity="0">
            <Border.Background>
                <SolidColorBrush Color="#33FF2A2A" />
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#FF2A2A" BlurRadius="22" ShadowDepth="0" Opacity="1" />
            </Border.Effect>
        </Border>

        <!-- Boss skill under the target frame -->
        <Border x:Name="CastBanner" Padding="14,6" CornerRadius="4" Visibility="Collapsed" Opacity="0"
                Background="#E6140A0C" BorderBrush="#FFE5484D" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="CastBoss" Foreground="#FFFF9A90" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="CastSkill" Foreground="White" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
