<UserControl x:Class="Avion2.Overlay.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{DynamicResource CardHeading}" FontSize="28" Margin="0,0,0,16" />

            <!-- General -->
            <Border Style="{DynamicResource Panel}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="General" Style="{StaticResource Heading}" />
                    <CheckBox Content="Start the meter automatically when AVION2 opens" IsChecked="{Binding AutoStart}" />
                    <CheckBox x:Name="UpdateCheckBox" Content="Check for updates when AVION2 starts" Margin="0,8,0,0" />
                    <DockPanel Margin="0,8,0,0">
                        <Button x:Name="CheckNowButton" DockPanel.Dock="Right" Content="Check now" Click="CheckNow_Click" />
                        <TextBlock x:Name="VersionText" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="One request to the GitHub releases of void-cx/avion2. Nothing is downloaded until you choose &quot;Update now&quot;; AVION2-Updater.exe then installs the release and restarts AVION2." />
                </StackPanel>
            </Border>

            <!-- Timers -->
            <Border Style="{DynamicResource Panel}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Timers &amp; notifications" Style="{StaticResource Heading}" />
                    <DockPanel>
                        <TextBlock Text="Server region" Width="150" VerticalAlignment="Center" />
                        <ComboBox x:Name="RegionBox" Width="180" HorizontalAlignment="Left" SelectedItem="{Binding Region}" />
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Right" Width="60" TextAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding NotifyLeadMinutes, StringFormat={}{0} min}" />
                        <TextBlock Text="Notify before" Width="150" VerticalAlignment="Center" />
                        <Slider Minimum="1" Maximum="30" Value="{Binding NotifyLeadMinutes}" TickFrequency="1" IsSnapToTickEnabled="True" />
                    </DockPanel>
                    <WrapPanel Margin="150,8,0,0">
                        <CheckBox Content="Spacetime Rifts" IsChecked="{Binding NotifyRift}" Margin="0,0,16,4" />
                        <CheckBox Content="Beritra Air Raid" IsChecked="{Binding NotifyBossRaid}" Margin="0,0,16,4" />
                        <CheckBox Content="Field boss respawns" IsChecked="{Binding NotifyFieldBoss}" Margin="0,0,16,4" />
                        <CheckBox Content="Boss skill casts" IsChecked="{Binding NotifyBossCasts}" Margin="0,0,16,4"
                                  ToolTip="While the meter runs: a notice when a boss starts a named skill (no sound)." />
                        <CheckBox Content="Hourly field events" IsChecked="{Binding NotifyFieldEvents}" Margin="0,0,16,4" />
                        <CheckBox Content="PvP events" IsChecked="{Binding NotifyPvp}" Margin="0,0,16,4" />
                        <CheckBox Content="Resets" IsChecked="{Binding NotifyReset}" Margin="0,0,16,4" />
                        <CheckBox Content="Play a sound" IsChecked="{Binding NotifySound}" Margin="0,0,16,4" />
                    </WrapPanel>
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Built-in" Margin="6,0,0,0" Click="DefaultNoticeSound_Click" />
                        <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Click="BrowseNoticeSound_Click" />
                        <Button DockPanel.Dock="Right" Content="▶ Test" Margin="6,0,0,0" Click="TestNoticeSound_Click" />
                        <TextBlock Text="Notification sound" Width="150" VerticalAlignment="Center" />
                        <TextBlock x:Name="NoticeSoundName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding NoticeVolume, StringFormat={}{0:P0}}" />
                        <TextBlock Text="Notification volume" Width="150" VerticalAlignment="Center" />
                        <Slider Minimum="0" Maximum="1" Value="{Binding NoticeVolume}" SmallChange="0.05" LargeChange="0.1"
                                TickFrequency="0.05" IsSnapToTickEnabled="True" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="150,6,0,0">
                        <Button Content="Show a test notification" Margin="0,0,6,0" Click="TestNotification_Click" />
                        <Button Content="Move notification area" Click="MoveNotifications_Click" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Notices appear in their own transparent, click-through area on top of the game; place it with &quot;Move notification area&quot;. Timetable from aion2hub.com (Global client of 2026-09-19). Field boss respawns come from the game itself (for the maps you visited with the meter running)." />
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{DynamicResource Panel}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource Heading}" />
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Theme" Width="150" VerticalAlignment="Center" />
                        <ComboBox x:Name="ThemeBox" Width="180" HorizontalAlignment="Left" />
                        <TextBlock x:Name="ThemeHint" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.7" FontSize="11" TextWrapping="Wrap" />
                    </DockPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="None" Margin="6,0,0,0" Click="NoVideo_Click" />
                        <Button DockPanel.Dock="Right" Content="Default" Margin="6,0,0,0" Click="DefaultVideo_Click" />
                        <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Click="BrowseVideo_Click" />
                        <TextBlock Text="Home background" Width="150" VerticalAlignment="Center" />
                        <TextBlock x:Name="VideoName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Open folder" Margin="6,0,0,0" Click="ClassIcons_Click" />
                        <TextBlock Text="Class icons" Width="150" VerticalAlignment="Center" />
                        <TextBlock x:Name="IconStatus" TextWrapping="Wrap" Opacity="0.85" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="A looping video behind the home page (e.g. the official key-art loop). Default: %AppData%\AVION2\background.mp4. Stays on your PC." />
                </StackPanel>
            </Border>

            <!-- Overlay -->
            <Border Style="{DynamicResource Panel}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Overlay" Style="{StaticResource Heading}" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding BackgroundOpacity, StringFormat={}{0:P0}}" />
                        <TextBlock Text="Background opacity" Width="150" VerticalAlignment="Center" />
                        <Slider Minimum="0.2" Maximum="1" Value="{Binding BackgroundOpacity}" SmallChange="0.05" LargeChange="0.1" />
                    </DockPanel>
                    <CheckBox Margin="0,8,0,0" Content="Show all targets nearby (not only the ones I hit)" IsChecked="{Binding AllTargets}" />
                    <CheckBox Margin="0,4,0,0" Content="Lock overlay (click-through to the game)" IsChecked="{Binding Locked}" />
                    <CheckBox Margin="0,4,0,0" Content="Compact rows (one line per player instead of player cards)" IsChecked="{Binding CompactRows}" />
                    <TextBlock Style="{StaticResource Hint}" Text="While locked, unlock with Ctrl+Shift+L." />
                </StackPanel>
            </Border>

            <!-- Low HP alert -->
            <Border Style="{DynamicResource Panel}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Low-HP alert" Style="{StaticResource Heading}" />
                    <CheckBox Content="Play a sound and flash the overlay when my HP is low" IsChecked="{Binding LowHpAlert}" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding LowHpThreshold, StringFormat={}{0:P0}}" />
                        <TextBlock Text="Warn below" Width="150" VerticalAlignment="Center" />
                        <Slider Minimum="0.1" Maximum="0.7" Value="{Binding LowHpThreshold}" SmallChange="0.05" LargeChange="0.1"
                                TickFrequency="0.05" IsSnapToTickEnabled="True" />
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding AlertVolume, StringFormat={}{0:P0}}" />
                        <TextBlock Text="Volume" Width="150" VerticalAlignment="Center" />
                        <Slider Minimum="0" Maximum="1" Value="{Binding AlertVolume}" SmallChange="0.05" LargeChange="0.1"
                                TickFrequency="0.05" IsSnapToTickEnabled="True" />
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Built-in" Margin="6,0,0,0" Click="DefaultSound_Click" />
                        <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Click="BrowseSound_Click" />
                        <Button DockPanel.Dock="Right" Content="▶ Test" Margin="6,0,0,0" Click="TestSound_Click" />
                        <TextBlock Text="Alert sound" Width="150" VerticalAlignment="Center" />
                        <TextBlock x:Name="SoundName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Max HP is never sent by the game; it is learned from the highest HP seen and remembered per character." />
                </StackPanel>
            </Border>

            <!-- Game data -->
            <Border Style="{DynamicResource Panel}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Skill and NPC names" Style="{StaticResource Heading}" />
                    <TextBlock x:Name="DataStatus" TextWrapping="Wrap" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="Language" Width="150" VerticalAlignment="Center" />
                        <ComboBox x:Name="LanguageBox" Width="120" HorizontalAlignment="Left" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Built into the app: names from the A2Tools project (GPL-3.0), field bosses from NOIA2 (GPL-3.0); see licenses\ next to the exe. Advanced: skills.json / npcs.json / field_bosses.json / maps.json in %AppData%\AVION2\data override single tables." />
                </StackPanel>
            </Border>

            <!-- History -->
            <Border Style="{DynamicResource Panel}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Fight history" Style="{StaticResource Heading}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Open folder" Click="HistoryFolder_Click" />
                        <TextBlock x:Name="HistoryStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Finished fights are saved as JSON (newest 300). They include other players' names: keep them to yourself unless those players agree." />
                </StackPanel>
            </Border>

            <!-- Hotkeys -->
            <Border Style="{DynamicResource Panel}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Hotkeys" Style="{StaticResource Heading}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Ctrl+Shift+L" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Lock / unlock the overlay" />
                        <TextBlock Grid.Row="1" Text="Ctrl+Shift+R" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Reset the current fight" />
                        <TextBlock Grid.Row="2" Text="Ctrl+Shift+O" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Hide / show the overlay" />
                        <TextBlock Grid.Row="3" Text="Ctrl+Wheel" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Over the overlay header: opacity" />
                        <TextBlock Grid.Row="4" Text="Wheel" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Over the speaker icon: alert volume" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
