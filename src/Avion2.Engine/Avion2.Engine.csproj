<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Avion2.Capture\Avion2.Capture.csproj" />
    <ProjectReference Include="..\Avion2.Analysis\Avion2.Analysis.csproj" />
  </ItemGroup>

  <!-- Name tables shipped inside the binary (see assets/gamedata/PROVENANCE.md); no downloads at runtime. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\gamedata\skills\*.json" LogicalName="gamedata/skills/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\gamedata\npcs\*.json" LogicalName="gamedata/npcs/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\gamedata\maps\*.json" LogicalName="gamedata/maps/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\gamedata\field_bosses.json" LogicalName="gamedata/field_bosses.json" />
    <EmbeddedResource Include="..\..\assets\gamedata\gear_forge.json" LogicalName="gamedata/gear_forge.json" />
    <EmbeddedResource Include="..\..\assets\gamedata\dungeons.json" LogicalName="gamedata/dungeons.json" />
    <EmbeddedResource Include="..\..\assets\gamedata\world\*.*" LogicalName="gamedata/world/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\gamedata\world\icons\*.png" LogicalName="gamedata/world/icons/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
